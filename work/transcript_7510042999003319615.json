    {
      "start": 650.28,
      "end": 652.0,
      "text": "财务转型经验"
    },
    {
      "start": 652.0,
      "end": 654.84,
      "text": "在这里 我个人对这个案例进行总结"
    },
    {
      "start": 654.84,
      "end": 656.48,
      "text": "这个案例的精髓是什么"
    },
    {
      "start": 656.48,
      "end": 658.8000000000001,
      "text": "其实就是跨行业的财务思路"
    },
    {
      "start": 658.8000000000001,
      "end": 660.48,
      "text": "第一 工作量折就法"
    },
    {
      "start": 660.48,
      "end": 661.9200000000001,
      "text": "通常用于什么行业"
    },
    {
      "start": 661.9200000000001,
      "end": 663.72,
      "text": "一般是用于采矿业"
    },
    {
      "start": 663.72,
      "end": 665.8000000000001,
      "text": "物流行业 飞机和船舶"
    },
    {
      "start": 665.8000000000001,
      "end": 666.76,
      "text": "这种折就方法"
    },
    {
      "start": 666.76,
      "end": 668.72,
      "text": "通常是针对于业务波动大"
    },
    {
      "start": 668.72,
      "end": 670.36,
      "text": "设备随行与生产"
    },
    {
      "start": 670.36,
      "end": 671.76,
      "text": "强观联的领域"
    },
    {
      "start": 671.76,
      "end": 673.88,
      "text": "华学厂采用这种折就方法"
    },
    {
      "start": 673.88,
      "end": 676.12,
      "text": "其实是合理且贴合业务"
    },
    {
      "start": 676.12,
      "end": 678.0,
      "text": "这样更能有效做财务分析"
    },
    {
      "start": 678.0,
      "end": 680.84,
      "text": "第二 减质的设备租令"
    },
    {
      "start": 680.84,
      "end": 681.44,
      "text": "我们知道"
    },
    {
      "start": 681.44,
      "end": 684.12,
      "text": "干租和施租是在建筑施工行业"
    },
    {
      "start": 684.12,
      "end": 685.72,
      "text": "经常用大的一种模式"
    },
    {
      "start": 685.72,
      "end": 688.36,
      "text": "小区总巧妙地用到了华学厂的"
    },
    {
      "start": 688.36,
      "end": 691.2,
      "text": "机械租金上非常棒的一个跨行业思路"
    },
    {
      "start": 691.2,
      "end": 692.48,
      "text": "第三 研学"
    },
    {
      "start": 692.48,
      "end": 694.6,
      "text": "通常是教育机构和旅行社的"
    },
    {
      "start": 694.6,
      "end": 695.72,
      "text": "主要业务限制业"
    },
    {
      "start": 695.72,
      "end": 698.64,
      "text": "小区总将其引入到华学厂的经营种"
    },
    {
      "start": 698.64,
      "end": 700.44,
      "text": "这个案例完美地展现出来"
    },
    {
      "start": 700.44,
      "end": 702.5600000000001,
      "text": "财务人员跨行业的工作思路"
    },
    {
      "start": 702.5600000000001,
      "end": 705.6800000000001,
      "text": "依托主营业务和自身强大的规模"
    },
    {
      "start": 705.6800000000001,
      "end": 707.2,
      "text": "向周边产业进发"
    },
    {
      "start": 707.2,
      "end": 708.6800000000001,
      "text": "稳扎稳打 精打气算"
    },
    {
      "start": 708.6800000000001,
      "end": 710.32,
      "text": "精准的财务决策"
    },
    {
      "start": 710.32,
      "end": 712.2,
      "text": "服以超强恐怖的执行能力"
    },
    {
      "start": 712.2,
      "end": 714.1600000000001,
      "text": "所以你觉得这样的财务总监"
    },
    {
      "start": 714.16,
      "end": 715.68,
      "text": "应该年薪多少钱"
