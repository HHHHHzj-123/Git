      "start": 603.96,
      "end": 606.08,
      "text": "避免拍脑子式的决策习惯"
    },
    {
      "start": 606.08,
      "end": 607.36,
      "text": "我发现有很多民营企业"
    },
    {
      "start": 607.36,
      "end": 608.64,
      "text": "尤其中小型民营企"
    },
    {
      "start": 608.64,
      "end": 609.6800000000001,
      "text": "特别喜欢拍脑子"
    },
    {
      "start": 609.6800000000001,
      "end": 611.0,
      "text": "不看数据不看报表"
    },
    {
      "start": 611.0,
      "end": 612.5600000000001,
      "text": "第二 小成本是错"
    },
    {
      "start": 612.5600000000001,
      "end": 613.8000000000001,
      "text": "渐进式的创新"
    },
    {
      "start": 613.8000000000001,
      "end": 615.5600000000001,
      "text": "优先选择改造成本"
    },
    {
      "start": 615.5600000000001,
      "end": 617.44,
      "text": "第一 渐消快的业务视水"
    },
    {
      "start": 617.44,
      "end": 618.8000000000001,
      "text": "降低视错风险"
    },
    {
      "start": 618.8000000000001,
      "end": 620.5600000000001,
      "text": "避免大成本视错"
    },
    {
      "start": 620.5600000000001,
      "end": 622.52,
      "text": "第三 业务财务深度合作"
    },
    {
      "start": 622.52,
      "end": 624.52,
      "text": "财务人员参与业务全流程"
