{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 3.36,
      "text": "你觉得这样的财务总监应该年薪多少钱"
    },
    {
      "start": 3.36,
      "end": 4.6000000000000005,
      "text": "靠着一项操作"
    },
    {
      "start": 4.6000000000000005,
      "end": 7.5200000000000005,
      "text": "华学厂在夏季营收达4500万元"
    },
    {
      "start": 7.5200000000000005,
      "end": 10.64,
      "text": "本案例是由小徐总本人亲自提供"
    },
    {
      "start": 10.64,
      "end": 15.48,
      "text": "这个案例我们讲的是如果产品或者服务严重依赖季节性因素"
    },
    {
      "start": 15.48,
      "end": 20.8,
      "text": "财务公文该如何将靠天吃饭转为四季运营"
    },
    {
      "start": 20.8,
      "end": 22.44,
      "text": "先介绍一下企业背景"
    },
    {
      "start": 22.44,
      "end": 26.16,
      "text": "公司是处于东北地区的一家大型华学厂"
    },
    {
      "start": 26.16,
      "end": 28.96,
      "text": "运营初期凭借东际的客流优势"
    },
    {
      "start": 28.96,
      "end": 32.24,
      "text": "年接待华学游客超50万人次"
    },
    {
      "start": 32.24,
      "end": 35.480000000000004,
      "text": "营收规模达2.8个亿很大了吧"
    },
    {
      "start": 35.480000000000004,
      "end": 40.160000000000004,
      "text": "但随着行业竞争加剧及季节性经营的必端凸显"
    },
    {
      "start": 40.160000000000004,
      "end": 43.92,
      "text": "2021年到2022年经营陷入困境"
    },
    {
      "start": 43.92,
      "end": 47.28,
      "text": "这时候公司引入了小徐总任职财务负责人"
    },
    {
      "start": 47.28,
      "end": 51.400000000000006,
      "text": "小徐总进入公司后第一步是通过财务分析"
    },
    {
      "start": 51.400000000000006,
      "end": 53.96,
      "text": "得到量化的数据发现企业痛点"
    },
    {
      "start": 53.96,
      "end": 55.44,
      "text": "一 成本居高不下"
    },
    {
      "start": 55.44,
      "end": 56.68,
      "text": "全年运营成本中"
    },
    {
      "start": 56.68,
      "end": 59.76,
      "text": "学厂维护费用占比高达65%"
    },
    {
      "start": 59.76,
      "end": 62.0,
      "text": "学厂每年投入1.2亿元"
    },
    {
      "start": 62.0,
      "end": 64.68,
      "text": "用于造决压血设备及人工维护"
    },
    {
      "start": 64.68,
      "end": 66.16,
      "text": "而在非血剂的情况下"
    },
    {
      "start": 66.16,
      "end": 69.08,
      "text": "设备又闲置折扣费用超2000万元"
    },
    {
      "start": 69.08,
      "end": 70.56,
      "text": "占比达18%"
    },
    {
      "start": 70.56,
      "end": 71.56,
      "text": "尤其是夏季"
    },
    {
      "start": 71.56,
      "end": 73.2,
      "text": "人流量较少的情况下"
    },
    {
      "start": 73.2,
      "end": 76.2,
      "text": "场地闲置导致固定成本分担大"
    },
    {
      "start": 76.2,
      "end": 77.24000000000001,
      "text": "三个客人成本"
    },
    {
      "start": 77.24000000000001,
      "end": 79.56,
      "text": "平均比旺季高出三倍"
    },
    {
      "start": 79.56,
      "end": 82.52000000000001,
      "text": "非血剂员工闲置率达70%"
    },
    {
      "start": 82.52,
      "end": 83.52,
      "text": "人类成本"
    },
    {
      "start": 83.52,
      "end": 84.39999999999999,
      "text": "刚性支出"
    },
    {
      "start": 84.39999999999999,
      "end": 86.36,
      "text": "占全年总成本15%"
    },
    {
      "start": 86.36,
      "end": 88.08,
      "text": "第二 营收结构单一"
    },
    {
      "start": 88.08,
      "end": 89.32,
      "text": "90%收入"
    },
    {
      "start": 89.32,
      "end": 92.36,
      "text": "集中在12月到4年2月的滑雪剂"
    },
    {
      "start": 92.36,
      "end": 95.36,
      "text": "非血剂收入不足全年营收的10%"
    },
    {
      "start": 95.36,
      "end": 97.0,
      "text": "非血剂期间的场地"
    },
    {
      "start": 97.0,
      "end": 98.03999999999999,
      "text": "懒车等设备"
    },
    {
      "start": 98.03999999999999,
      "end": 99.8,
      "text": "利用率不足15%"
    },
    {
      "start": 99.8,
      "end": 102.8,
      "text": "曾尝试举办草地音乐节等活动"
    },
    {
      "start": 102.8,
      "end": 104.28,
      "text": "但于缺乏成本测算"
    },
    {
      "start": 104.28,
      "end": 105.84,
      "text": "曾出现单次活动"
    },
    {
      "start": 105.84,
      "end": 108.0,
      "text": "亏损80万元的这种情况"
    },
    {
      "start": 108.0,
      "end": 110.6,
      "text": "非血剂仅靠零星团建活动"
    },
    {
      "start": 110.6,
      "end": 112.0,
      "text": "也是难以维持的"
    },
    {
      "start": 112.0,
      "end": 114.32,
      "text": "企业全年亏损超3000万元"
    },
    {
      "start": 114.32,
      "end": 116.48,
      "text": "第三 资金周转压力大"
    },
    {
      "start": 116.48,
      "end": 118.16,
      "text": "血剧采购"
    },
    {
      "start": 118.16,
      "end": 119.44,
      "text": "造血设备升级等"
    },
    {
      "start": 119.44,
      "end": 120.72,
      "text": "需要提前电资"
    },
    {
      "start": 120.72,
      "end": 121.84,
      "text": "血剂之前"
    },
    {
      "start": 121.84,
      "end": 124.04,
      "text": "需储备6000万人民币"
    },
    {
      "start": 124.04,
      "end": 126.8,
      "text": "用于血剂的采购和造血耗材"
    },
    {
      "start": 126.8,
      "end": 128.72,
      "text": "非血剂现金流枯竭"
    },
    {
      "start": 128.72,
      "end": 131.2,
      "text": "依赖短期贷款维持运营"
    },
    {
      "start": 131.2,
      "end": 133.6,
      "text": "年融资成本高达1200万元"
    },
    {
      "start": 133.6,
      "end": 134.72,
      "text": "通过财务分析"
    },
    {
      "start": 134.72,
      "end": 135.92000000000002,
      "text": "发现问题根源"
    },
    {
      "start": 135.92000000000002,
      "end": 137.28,
      "text": "在于过度依赖"
    },
    {
      "start": 137.28,
      "end": 138.4,
      "text": "单一季节性业务"
    },
    {
      "start": 138.4,
      "end": 140.72,
      "text": "成本控制缺乏全周期规划"
    },
    {
      "start": 140.8,
      "end": 142.96,
      "text": "财务决策之后于市场变化"
    },
    {
      "start": 142.96,
      "end": 144.8,
      "text": "如果你是一个财务老大"
    },
    {
      "start": 144.8,
      "end": 146.64,
      "text": "请问你该如何下手"
    },
    {
      "start": 146.64,
      "end": 149.36,
      "text": "这里会给你们一些非常不一样的思路"
    },
    {
      "start": 149.36,
      "end": 150.48,
      "text": "拓宽大家的思路"
    },
    {
      "start": 150.48,
      "end": 152.24,
      "text": "这个是人家成功的经验"
    },
    {
      "start": 152.24,
      "end": 153.6,
      "text": "我讲的都不是AI"
    },
    {
      "start": 153.6,
      "end": 156.48,
      "text": "都是我们的朋友或者学员提供的"
    },
    {
      "start": 156.48,
      "end": 158.32,
      "text": "改革分三步推进"
    },
    {
      "start": 158.32,
      "end": 159.92,
      "text": "实现了全年都盈利"
    },
    {
      "start": 159.92,
      "end": 160.4,
      "text": "第一步"
    },
    {
      "start": 160.4,
      "end": 162.8,
      "text": "建立全周期成本管控体系"
    },
    {
      "start": 162.8,
      "end": 163.92,
      "text": "财务关键点"
    },
    {
      "start": 163.92,
      "end": 166.16,
      "text": "打破血剂优先思维"
    },
    {
      "start": 166.16,
      "end": 168.56,
      "text": "将全年成本按固定成本分摊"
    },
    {
      "start": 168.56,
      "end": 170.56,
      "text": "大家动态业务投入策略"
    },
    {
      "start": 170.56,
      "end": 171.52,
      "text": "重新分配"
    },
    {
      "start": 171.52,
      "end": 173.68,
      "text": "让财务核算和财务分析"
    },
    {
      "start": 173.68,
      "end": 175.84,
      "text": "更贴合实际运营情况"
    },
    {
      "start": 175.84,
      "end": 177.36,
      "text": "从而发现解决方案"
    },
    {
      "start": 177.36,
      "end": 178.32,
      "text": "落地方法"
    },
    {
      "start": 178.32,
      "end": 180.56,
      "text": "针对下纪闲置设备"
    },
    {
      "start": 180.56,
      "end": 182.88,
      "text": "小徐总引入分十折旧法"
    },
    {
      "start": 182.88,
      "end": 184.0,
      "text": "将设备折旧"
    },
    {
      "start": 184.0,
      "end": 186.16,
      "text": "与实际使用时长挂钩"
    },
    {
      "start": 186.16,
      "end": 188.96,
      "text": "这里针对的是管理报表的分析"
    },
    {
      "start": 188.96,
      "end": 190.32,
      "text": "是公司内部的报表"
    },
    {
      "start": 190.32,
      "end": 192.48000000000002,
      "text": "而不是针对数机关报送的财报"
    },
    {
      "start": 192.48000000000002,
      "end": 193.36,
      "text": "分十折旧法"
    },
    {
      "start": 193.36,
      "end": 195.04,
      "text": "事务机关是不认可的"
    },
    {
      "start": 195.04,
      "end": 195.84,
      "text": "但后来"
    },
    {
      "start": 195.84,
      "end": 196.88,
      "text": "小徐总发现"
    },
    {
      "start": 196.88,
      "end": 197.84,
      "text": "分十折旧法"
    },
    {
      "start": 197.92000000000002,
      "end": 200.48,
      "text": "与工作量折旧法一举同工"
    },
    {
      "start": 200.48,
      "end": 203.20000000000002,
      "text": "于是又与事务机关进行了积极的沟通"
    },
    {
      "start": 203.20000000000002,
      "end": 204.8,
      "text": "做了进一步的尝试"
    },
    {
      "start": 204.8,
      "end": 206.96,
      "text": "事务机关的同志们也很专业"
    },
    {
      "start": 206.96,
      "end": 207.84,
      "text": "最终认可了"
    },
    {
      "start": 207.84,
      "end": 209.52,
      "text": "工作量折旧法的方式"
    },
    {
      "start": 209.52,
      "end": 210.8,
      "text": "企业按照规定"
    },
    {
      "start": 210.8,
      "end": 212.56,
      "text": "在事务机关做了备案"
    },
    {
      "start": 212.56,
      "end": 213.76,
      "text": "因为公司的股东们"
    },
    {
      "start": 213.76,
      "end": 215.28,
      "text": "对财务支持没有那么专业"
    },
    {
      "start": 215.28,
      "end": 216.96,
      "text": "他们还是希望财务部门"
    },
    {
      "start": 216.96,
      "end": 218.08,
      "text": "按照分十折旧法"
    },
    {
      "start": 218.08,
      "end": 219.92000000000002,
      "text": "做内部管理财务分析"
    },
    {
      "start": 219.92000000000002,
      "end": 222.32,
      "text": "公司在报送给事务机关数据时"
    },
    {
      "start": 222.32,
      "end": 223.68,
      "text": "将分十折旧法"
    },
    {
      "start": 223.68,
      "end": 225.2,
      "text": "转成事务机关认可的"
    },
    {
      "start": 225.20000000000002,
      "end": 227.28000000000003,
      "text": "工作量折旧法进行报送"
    },
    {
      "start": 227.28000000000003,
      "end": 229.28000000000003,
      "text": "工作量折旧法计算公式"
    },
    {
      "start": 229.28000000000003,
      "end": 230.64000000000001,
      "text": "单位工作量折旧额"
    },
    {
      "start": 230.64000000000001,
      "end": 233.52,
      "text": "等于固定资产原值减预计残值"
    },
    {
      "start": 233.52,
      "end": 235.52,
      "text": "除以预计总工作量"
    },
    {
      "start": 235.52,
      "end": 237.36,
      "text": "它是以总工作量作为核算的"
    },
    {
      "start": 237.36,
      "end": 240.00000000000003,
      "text": "当期折旧额等于当期实际工作量"
    },
    {
      "start": 240.00000000000003,
      "end": 241.84000000000003,
      "text": "成于单位工作量折旧额"
    },
    {
      "start": 241.84000000000003,
      "end": 242.8,
      "text": "关键限制"
    },
    {
      "start": 242.8,
      "end": 243.20000000000002,
      "text": "第一"
    },
    {
      "start": 243.20000000000002,
      "end": 245.20000000000002,
      "text": "事务机关允许采用工作量法"
    },
    {
      "start": 245.20000000000002,
      "end": 247.68,
      "text": "但需符合与收入配比原则"
    },
    {
      "start": 247.68,
      "end": 248.00000000000003,
      "text": "第二"
    },
    {
      "start": 248.00000000000003,
      "end": 249.44000000000003,
      "text": "需在事务机关进行备案"
    },
    {
      "start": 249.44000000000003,
      "end": 250.96,
      "text": "并提供合理的工作量"
    },
    {
      "start": 250.96,
      "end": 253.60000000000002,
      "text": "策算依据能准确计量使用量"
    },
    {
      "start": 253.6,
      "end": 255.2,
      "text": "但比如像办公楼"
    },
    {
      "start": 255.2,
      "end": 256.88,
      "text": "加剧无明确使用"
    },
    {
      "start": 256.88,
      "end": 258.15999999999997,
      "text": "计量标准的资产"
    },
    {
      "start": 258.15999999999997,
      "end": 260.48,
      "text": "是不能使用这种折旧方法的"
    },
    {
      "start": 260.48,
      "end": 261.04,
      "text": "所以"
    },
    {
      "start": 261.04,
      "end": 262.64,
      "text": "你要知道什么样的设备"
    },
    {
      "start": 262.64,
      "end": 265.36,
      "text": "可以允许使用工作量折旧法"
    },
    {
      "start": 265.36,
      "end": 265.84,
      "text": "第三"
    },
    {
      "start": 265.84,
      "end": 267.52,
      "text": "一旦使用工作量折旧法"
    },
    {
      "start": 267.52,
      "end": 269.6,
      "text": "就不能随意进行变更"
    },
    {
      "start": 269.6,
      "end": 270.08,
      "text": "第四"
    },
    {
      "start": 270.08,
      "end": 272.56,
      "text": "如果财务人员管理水平不高"
    },
    {
      "start": 272.56,
      "end": 274.48,
      "text": "建议由快支入所"
    },
    {
      "start": 274.48,
      "end": 276.04,
      "text": "或者专业机构介入"
    },
    {
      "start": 276.04,
      "end": 276.96,
      "text": "帮助完成"
    },
    {
      "start": 276.96,
      "end": 277.44,
      "text": "其次"
    },
    {
      "start": 277.44,
      "end": 280.71999999999997,
      "text": "解决非血计人力成本的问题"
    },
    {
      "start": 280.71999999999997,
      "end": 282.4,
      "text": "推动一港多能培训"
    },
    {
      "start": 282.40000000000003,
      "end": 284.20000000000005,
      "text": "将部分学厂维护人员"
    },
    {
      "start": 284.20000000000005,
      "end": 286.00000000000006,
      "text": "转为夏季警官维护"
    },
    {
      "start": 286.00000000000006,
      "end": 287.52000000000004,
      "text": "或活动执行岗位"
    },
    {
      "start": 287.52000000000004,
      "end": 288.88000000000005,
      "text": "改革其实是有阻力的"
    },
    {
      "start": 288.88000000000005,
      "end": 289.56000000000006,
      "text": "落地阻力"
    },
    {
      "start": 289.56000000000006,
      "end": 291.72,
      "text": "运营部门反对人力结构调整"
    },
    {
      "start": 291.72,
      "end": 293.52000000000004,
      "text": "担心影响血计期间"
    },
    {
      "start": 293.52000000000004,
      "end": 294.76000000000005,
      "text": "运营人员的专业性"
    },
    {
      "start": 294.76000000000005,
      "end": 296.8,
      "text": "财务团队通过策算发现"
    },
    {
      "start": 296.8,
      "end": 298.76000000000005,
      "text": "非血计员工薪资"
    },
    {
      "start": 298.76000000000005,
      "end": 300.40000000000003,
      "text": "如果降低30%"
    },
    {
      "start": 300.40000000000003,
      "end": 302.52000000000004,
      "text": "可减少全年人力成本"
    },
    {
      "start": 302.52000000000004,
      "end": 303.36,
      "text": "800万元"
    },
    {
      "start": 303.36,
      "end": 305.04,
      "text": "如果能够减少800万元"
    },
    {
      "start": 305.04,
      "end": 307.40000000000003,
      "text": "那么我们就值得去尝试一下"
    },
    {
      "start": 307.40000000000003,
      "end": 308.88000000000005,
      "text": "小区总公司降薪"
    },
    {
      "start": 308.88000000000005,
      "end": 310.72,
      "text": "并没有采取一刀旗的"
    },
    {
      "start": 310.88000000000005,
      "end": 311.72,
      "text": "降薪方式"
    },
    {
      "start": 311.72,
      "end": 313.36,
      "text": "而是更具备人性化"
    },
    {
      "start": 313.36,
