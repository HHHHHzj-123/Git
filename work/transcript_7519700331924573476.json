      "text": "为什么要搭建订单收盂系统"
    },
    {
      "start": 528.6,
      "end": 532.1600000000001,
      "text": "是要保证下面门店不会私自收钱"
    },
    {
      "start": 532.1600000000001,
      "end": 534.0400000000001,
      "text": "不向总部上交"
