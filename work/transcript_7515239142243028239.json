{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 2.96,
      "text": "如何把一个不好的赛道盘活"
    },
    {
      "start": 2.96,
      "end": 3.64,
      "text": "宠物残葬"
    },
    {
      "start": 3.64,
      "end": 5.04,
      "text": "这是一个非常小众的赛道"
    },
    {
      "start": 5.04,
      "end": 6.0,
      "text": "本人也不大挣钱"
    },
    {
      "start": 6.0,
      "end": 7.12,
      "text": "他们也是不挣钱"
    },
    {
      "start": 7.12,
      "end": 8.88,
      "text": "后来因为小夏总的到来"
    },
    {
      "start": 8.88,
      "end": 10.72,
      "text": "改变了产品线和服务渠道"
    },
    {
      "start": 10.72,
      "end": 11.44,
      "text": "现在盈利了"
    },
    {
      "start": 11.44,
      "end": 12.76,
      "text": "而且成为一个标杆企业"
    },
    {
      "start": 12.76,
      "end": 14.68,
      "text": "也是很有意义的一个案例"
    },
    {
      "start": 14.68,
      "end": 16.12,
      "text": "希望大家能多学学知识"
    },
    {
      "start": 16.12,
      "end": 17.6,
      "text": "能给你们带来生殖家居"
    },
    {
      "start": 17.6,
      "end": 18.88,
      "text": "或者能够创业成功"
    },
    {
      "start": 18.88,
      "end": 19.56,
      "text": "一直在讲"
    },
    {
      "start": 19.56,
      "end": 21.56,
      "text": "改变公司是从四个方面入手"
    },
    {
      "start": 21.56,
      "end": 22.76,
      "text": "一个是商业模式"
    },
    {
      "start": 22.76,
      "end": 24.28,
      "text": "还有组织形式"
    },
    {
      "start": 24.28,
      "end": 25.2,
      "text": "资产配置"
    },
    {
      "start": 25.2,
      "end": 27.44,
      "text": "最后一个其实是产品结构"
    },
    {
      "start": 27.44,
      "end": 29.0,
      "text": "我们今天就来谈谈"
    },
    {
      "start": 29.0,
      "end": 30.72,
      "text": "业才融合中的产品片"
    },
    {
      "start": 30.72,
      "end": 32.6,
      "text": "一个宠物殡葬服务公司"
    },
    {
      "start": 32.6,
      "end": 34.76,
      "text": "它是2019年成立的"
    },
    {
      "start": 34.76,
      "end": 36.08,
      "text": "七出的投入"
    },
    {
      "start": 36.08,
      "end": 37.4,
      "text": "差不多85万"
    },
    {
      "start": 37.4,
      "end": 39.480000000000004,
      "text": "要建设标准化的火化厂"
    },
    {
      "start": 39.480000000000004,
      "end": 42.2,
      "text": "配置了两台国产环保的火化设备"
    },
    {
      "start": 42.2,
      "end": 43.08,
      "text": "这项业务"
    },
    {
      "start": 43.08,
      "end": 45.64,
      "text": "它是需要有营业执照和环保审批的"
    },
    {
      "start": 45.64,
      "end": 46.68,
      "text": "2019年成立"
    },
    {
      "start": 46.68,
      "end": 49.0,
      "text": "2023年企业经营出现危机了"
    },
    {
      "start": 49.0,
      "end": 50.760000000000005,
      "text": "核心矛盾就是传统关键"
    },
    {
      "start": 50.760000000000005,
      "end": 52.92,
      "text": "与产品需求存在严重分歧"
    },
    {
      "start": 52.92,
      "end": 54.72,
      "text": "这个我们都应该想得到吧"
    },
    {
      "start": 54.72,
      "end": 55.16,
      "text": "对吧"
    },
    {
      "start": 55.16,
      "end": 56.400000000000006,
      "text": "第一 传统关键"
    },
    {
      "start": 56.400000000000006,
      "end": 57.760000000000005,
      "text": "导致市场需求不佳"
    },
    {
      "start": 57.76,
      "end": 60.199999999999996,
      "text": "养导物的家庭虽然超过12万户"
    },
    {
      "start": 60.199999999999996,
      "end": 62.08,
      "text": "但90%的客户觉得"
    },
    {
      "start": 62.08,
      "end": 63.48,
      "text": "猫猫狗狗离世了"
    },
    {
      "start": 63.48,
      "end": 64.84,
      "text": "挖个坑埋了就行了"
    },
    {
      "start": 64.84,
      "end": 65.92,
      "text": "其实别说他们了"
    },
    {
      "start": 65.92,
      "end": 67.67999999999999,
      "text": "连我自己都也是这么想的"
    },
    {
      "start": 67.67999999999999,
      "end": 70.56,
      "text": "公司月均无量不足100单"
    },
    {
      "start": 70.56,
      "end": 72.36,
      "text": "仅达产能的30%"
    },
    {
      "start": 72.36,
      "end": 74.88,
      "text": "大量的设备和人员长期闲置"
    },
    {
      "start": 74.88,
      "end": 76.64,
      "text": "现金流濒零断裂"
    },
    {
      "start": 76.64,
      "end": 77.84,
      "text": "收入低的同时"
    },
    {
      "start": 77.84,
      "end": 79.52,
      "text": "固定成本支出还高"
    },
    {
      "start": 79.52,
      "end": 81.56,
      "text": "比如说火化设备它有燃料费"
    },
    {
      "start": 81.56,
      "end": 83.64,
      "text": "场地有租金 员工工资"
    },
    {
      "start": 83.64,
      "end": 85.4,
      "text": "这些都构成了刚性支出"
    },
    {
      "start": 85.4,
      "end": 86.44,
      "text": "2023年"
    },
    {
      "start": 86.44,
      "end": 87.64,
      "text": "公司账户余额"
    },
    {
      "start": 87.64,
      "end": 90.48,
      "text": "仅有5万元资金面临断裂"
    },
    {
      "start": 90.48,
      "end": 91.96,
      "text": "业务结构单一脆弱"
    },
    {
      "start": 91.96,
      "end": 94.2,
      "text": "定制的这个宠物骨灰盒"
    },
    {
      "start": 94.2,
      "end": 95.24,
      "text": "因需求低迷"
    },
    {
      "start": 95.24,
      "end": 96.44,
      "text": "导致库存机压"
    },
    {
      "start": 96.44,
      "end": 98.48,
      "text": "占用资金的差不多20万元"
    },
    {
      "start": 98.48,
      "end": 101.72,
      "text": "95%的收入依赖于基础火化服务"
    },
    {
      "start": 101.72,
      "end": 103.44,
      "text": "客单价仅为600-800"
    },
    {
      "start": 103.44,
      "end": 104.24,
      "text": "高端服务"
    },
    {
      "start": 104.24,
      "end": 106.75999999999999,
      "text": "比如说像猫狗的这个宠物的"
    },
    {
      "start": 106.75999999999999,
      "end": 107.72,
      "text": "纪念仪式"
    },
    {
      "start": 107.72,
      "end": 109.16,
      "text": "骨灰艺术品等等"
    },
    {
      "start": 109.16,
      "end": 111.12,
      "text": "销售量还不足5%"
    },
    {
      "start": 111.12,
      "end": 112.03999999999999,
      "text": "合规成本"
    },
    {
      "start": 112.03999999999999,
      "end": 113.2,
      "text": "又成为了压垮"
    },
    {
      "start": 113.2,
      "end": 114.72,
      "text": "利润的最后一根稻草"
    },
    {
      "start": 114.72,
      "end": 115.64,
      "text": "雪上加霜"
    },
    {
      "start": 115.68,
      "end": 118.0,
      "text": "环保部门要求在2023年底"
    },
    {
      "start": 118.0,
      "end": 120.44,
      "text": "以前升级火化炉排放系统"
    },
    {
      "start": 120.44,
      "end": 122.48,
      "text": "去追加30万元的投入"
    },
    {
      "start": 122.48,
      "end": 124.28,
      "text": "但股东因市场前景"
    },
    {
      "start": 124.28,
      "end": 125.52,
      "text": "已经彻底悲观"
    },
    {
      "start": 125.52,
      "end": 126.36,
      "text": "拒绝出资"
    },
    {
      "start": 126.36,
      "end": 127.52,
      "text": "认为行业太小"
    },
    {
      "start": 127.52,
      "end": 128.68,
      "text": "投钱是个无底洞"
    },
    {
      "start": 128.68,
      "end": 129.52,
      "text": "实话实讲"
    },
    {
      "start": 129.52,
      "end": 130.36,
      "text": "塞到小小"
    },
    {
      "start": 130.36,
      "end": 131.64,
      "text": "而且市场需要培育"
    },
    {
      "start": 131.64,
      "end": 132.48,
      "text": "最主要的是"
    },
    {
      "start": 132.48,
      "end": 133.2,
      "text": "人文的认知"
    },
    {
      "start": 133.2,
      "end": 134.24,
      "text": "产品不受欢迎"
    },
    {
      "start": 134.24,
      "end": 135.48,
      "text": "这里我其实满心疼"
    },
    {
      "start": 135.48,
      "end": 136.72,
      "text": "这个股东的公司不大"
    },
    {
      "start": 136.72,
      "end": 137.6,
      "text": "但难度不小"
    },
    {
      "start": 137.6,
      "end": 139.08,
      "text": "2023年7月份"
    },
    {
      "start": 139.08,
      "end": 140.44,
      "text": "股东下达最后通别"
    },
    {
      "start": 140.44,
      "end": 142.88,
      "text": "三个月必须提交可行性方案"
    },
    {
      "start": 142.88,
      "end": 144.44,
      "text": "否则启动清算程序"
    },
    {
      "start": 144.44,
      "end": 145.4,
      "text": "这股东不干了"
    },
    {
      "start": 145.44,
      "end": 146.12,
      "text": "股东施压"
    },
    {
      "start": 146.12,
      "end": 147.32,
      "text": "改革迫在眉睫"
    },
    {
      "start": 147.32,
      "end": 148.8,
      "text": "财务负责人小夏总"
    },
    {
      "start": 148.8,
      "end": 150.64000000000001,
      "text": "也是刚刚封架的集团的"
    },
    {
      "start": 150.64000000000001,
      "end": 152.48000000000002,
      "text": "通过与业务部门的深度调研"
    },
    {
      "start": 152.48000000000002,
      "end": 154.48000000000002,
      "text": "发现是传统关键与产品"
    },
    {
      "start": 154.48000000000002,
      "end": 155.68,
      "text": "有三大矛盾"
    },
    {
      "start": 155.68,
      "end": 156.08,
      "text": "第一"
    },
    {
      "start": 156.08,
      "end": 157.96,
      "text": "情感价值认知缺失"
    },
    {
      "start": 157.96,
      "end": 159.4,
      "text": "他们对养宠物"
    },
    {
      "start": 159.4,
      "end": 160.88,
      "text": "超过五年的宠物主人"
    },
    {
      "start": 160.88,
      "end": 161.64000000000001,
      "text": "进行了调查"
    },
    {
      "start": 161.64000000000001,
      "end": 164.0,
      "text": "发现80%的人未意识到"
    },
    {
      "start": 164.0,
      "end": 165.04000000000002,
      "text": "宠物殡葬服务"
    },
    {
      "start": 165.04000000000002,
      "end": 168.16,
      "text": "其实是对宠物情感寄托的一个延续"
    },
    {
      "start": 168.16,
      "end": 168.52,
      "text": "第二"
    },
    {
      "start": 168.52,
      "end": 170.20000000000002,
      "text": "环保意识没有被普及"
    },
    {
      "start": 170.20000000000002,
      "end": 171.68,
      "text": "土葬可能会造成"
    },
    {
      "start": 171.68,
      "end": 172.88,
      "text": "这种戏曲的传播"
    },
    {
      "start": 172.88,
      "end": 174.48,
      "text": "与污染的风险"
    },
    {
      "start": 174.48,
      "end": 175.72,
      "text": "但90%的客户"
    },
    {
      "start": 175.72,
      "end": 177.88,
      "text": "其实并没有接触过相关的科普"
    },
    {
      "start": 177.88,
      "end": 179.35999999999999,
      "text": "还有服务形态"
    },
    {
      "start": 179.35999999999999,
      "end": 180.35999999999999,
      "text": "固化局限"
    },
    {
      "start": 180.35999999999999,
      "end": 181.68,
      "text": "市场将宠物殡葬"
    },
    {
      "start": 181.68,
      "end": 183.07999999999998,
      "text": "等同于简单的火化"
    },
    {
      "start": 183.07999999999998,
      "end": 185.64,
      "text": "忽略着它的纪念仪式"
    },
    {
      "start": 185.64,
      "end": 187.4,
      "text": "情感陪伴等潜在需求"
    },
    {
      "start": 187.4,
      "end": 189.2,
      "text": "但以上的认知"
    },
    {
      "start": 189.2,
      "end": 190.8,
      "text": "它是需要逐步培养的"
    },
    {
      "start": 190.8,
      "end": 192.28,
      "text": "企业在已经没有资金"
    },
    {
      "start": 192.28,
      "end": 193.64,
      "text": "和时间来培养这个市场"
    },
    {
      "start": 193.64,
      "end": 195.4,
      "text": "现在它面临的是一个短期的"
    },
    {
      "start": 195.4,
      "end": 197.04,
      "text": "资金链断裂的风险"
    },
    {
      "start": 197.04,
      "end": 198.24,
      "text": "那怎么解决问题呢"
    },
    {
      "start": 198.24,
      "end": 198.88,
      "text": "我们来聊聊"
    },
    {
      "start": 198.88,
      "end": 199.88,
      "text": "你们会怎么解决"
    },
    {
      "start": 199.88,
      "end": 200.96,
      "text": "来 决定去打一下"
    },
    {
      "start": 200.96,
      "end": 202.32,
      "text": "贷款制标不制本"
    },
    {
      "start": 202.35999999999999,
      "end": 202.95999999999998,
      "text": "我们说了"
    },
    {
      "start": 202.95999999999998,
      "end": 204.64,
      "text": "你要融资的钱提一下"
    },
    {
      "start": 204.64,
      "end": 206.32,
      "text": "是一定产品过硬"
    },
    {
      "start": 206.32,
      "end": 207.44,
      "text": "你带来更多的钱"
    },
    {
      "start": 207.44,
      "end": 208.12,
      "text": "还是没用啊"
    },
    {
      "start": 208.12,
      "end": 209.16,
      "text": "没有人买单不行"
    },
    {
      "start": 209.16,
      "end": 211.35999999999999,
      "text": "主要是因为大家不重视这个瓶子"
    },
    {
      "start": 211.35999999999999,
      "end": 212.04,
      "text": "那怎么办"
    },
    {
      "start": 212.04,
      "end": 213.07999999999998,
      "text": "小夏总发现"
    },
    {
      "start": 213.07999999999998,
      "end": 215.6,
      "text": "宠物主人在买猫粮狗粮"
    },
    {
      "start": 215.6,
      "end": 216.92,
      "text": "或者零食的时候"
    },
    {
      "start": 216.92,
      "end": 217.92,
      "text": "花钱是大方的"
    },
    {
      "start": 217.92,
      "end": 219.84,
      "text": "但当宠物去市的时候"
    },
    {
      "start": 219.84,
      "end": 221.4,
      "text": "却不大愿意花钱"
    },
    {
      "start": 221.4,
      "end": 223.76,
      "text": "所以既然我这个赛道不大好"
    },
    {
      "start": 223.76,
      "end": 225.76,
      "text": "那我就将产品及服务"
    },
    {
      "start": 225.76,
      "end": 228.28,
      "text": "往产业链前端延伸"
    },
    {
      "start": 228.28,
      "end": 230.07999999999998,
      "text": "先渗透进去"
    },
    {
      "start": 230.07999999999998,
      "end": 231.24,
      "text": "先挣钱"
    },
    {
      "start": 231.28,
      "end": 232.84,
      "text": "再一步步改变"
    },
    {
      "start": 232.84,
      "end": 234.52,
      "text": "宠物主人的观念"
    },
    {
      "start": 234.52,
      "end": 235.52,
      "text": "这个思路一改变"
    },
    {
      "start": 235.52,
      "end": 237.24,
      "text": "就是我不固化在我的这个"
    },
    {
      "start": 237.24,
      "end": 238.32000000000002,
      "text": "并藏服务上面"
    },
    {
      "start": 238.32000000000002,
      "end": 239.88,
      "text": "哪有钱我往哪跑"
    },
    {
      "start": 239.88,
      "end": 241.92000000000002,
      "text": "小夏总他们是做的服务的"
    },
    {
      "start": 241.92000000000002,
      "end": 243.08,
      "text": "最后一站"
    },
    {
      "start": 243.08,
      "end": 244.36,
      "text": "但是往前走的话"
    },
    {
      "start": 244.36,
      "end": 247.12,
      "text": "他等于可以打通宠物行业的"
    },
    {
      "start": 247.12,
      "end": 248.36,
      "text": "全链条"
    },
    {
      "start": 248.36,
      "end": 249.44,
      "text": "一条龙服务"
    },
    {
      "start": 249.44,
      "end": 250.04000000000002,
      "text": "第一步"
    },
    {
      "start": 250.04000000000002,
      "end": 252.16000000000003,
      "text": "还是先从财务入手"
    },
    {
      "start": 252.16000000000003,
      "end": 253.84,
      "text": "先做成本优化"
    },
    {
      "start": 253.84,
      "end": 255.0,
      "text": "这样立干建营"
    },
    {
      "start": 255.0,
      "end": 255.84,
      "text": "开源节流"
    },
    {
      "start": 255.84,
      "end": 256.64,
      "text": "先做哪个"
    },
    {
      "start": 256.64,
      "end": 257.8,
      "text": "先做节流"
    },
    {
      "start": 257.8,
      "end": 258.92,
      "text": "因为立干建营"
    },
    {
      "start": 258.92,
      "end": 259.52,
      "text": "第一步"
    },
    {
      "start": 259.52,
      "end": 260.68,
      "text": "供应链降本"
    },
    {
