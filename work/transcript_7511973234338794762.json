    {
      "start": 293.84000000000003,
      "end": 294.76,
      "text": "晃来晃去"
    },
    {
      "start": 294.76,
      "end": 295.6,
      "text": "这很奸诈"
    },
    {
      "start": 295.6,
      "end": 297.20000000000005,
      "text": "你也不能死盯着"
    },
    {
      "start": 297.20000000000005,
      "end": 298.56,
      "text": "因为死盯着对方的眼睛"
    },
    {
      "start": 298.56,
      "end": 299.36,
      "text": "只有两种可能"
    },
    {
      "start": 299.36,
      "end": 300.48,
      "text": "一种是爱上对方了"
