    },
    {
      "start": 315.24,
      "end": 316.40000000000003,
      "text": "语言不啰嗦"
    },
    {
      "start": 316.40000000000003,
      "end": 317.68,
      "text": "简单直接有效"
    },
    {
      "start": 317.68,
      "end": 318.88,
      "text": "这是高手的体现"
    },
    {
      "start": 318.88,
      "end": 319.68,
      "text": "而且记住"
    },
    {
      "start": 319.72,
      "end": 320.76,
      "text": "不要高频的"
    },
    {
      "start": 320.76,
      "end": 322.6,
      "text": "不停的重复回答一个问题"
    },
    {
      "start": 322.6,
      "end": 324.6,
      "text": "高频回答代表的是非常低位"
    },
    {
      "start": 324.6,
      "end": 326.12,
      "text": "一着一定是"
    },
    {
      "start": 326.12,
      "end": 327.76,
      "text": "我不建议特别的板正"
    },
    {
      "start": 327.76,
      "end": 328.68,
      "text": "但是有隔调的"
    },
    {
      "start": 328.68,
      "end": 329.72,
      "text": "其实就是伪装"
    },
    {
      "start": 329.72,
      "end": 330.2,
      "text": "说对了"
    },
    {
      "start": 330.2,
      "end": 331.48,
      "text": "您是有你放松的时候"
    },
    {
      "start": 331.48,
      "end": 333.0,
      "text": "比如说面对你的发小"
    },
    {
      "start": 333.0,
      "end": 334.12,
      "text": "面对你的老同学"
    },
    {
      "start": 334.12,
      "end": 335.0,
      "text": "但是你对外"
    },
    {
      "start": 335.0,
      "end": 336.56,
      "text": "你在商业中工作中"
    },
    {
      "start": 336.56,
      "end": 338.6,
      "text": "你一定是要有自己的一个"
    },
    {
      "start": 338.6,
      "end": 339.6,
      "text": "腔调和做派"
    },
    {
      "start": 339.6,
      "end": 340.32,
      "text": "你是高手"
    },
    {
      "start": 340.32,
      "end": 341.88,
      "text": "人活日会比较累"
    },
    {
      "start": 341.88,
      "end": 343.36,
      "text": "第三个叫谋略"
    },
    {
      "start": 343.36,
      "end": 344.8,
      "text": "商场无战场"
    },
    {
      "start": 344.8,
      "end": 345.96000000000004,
      "text": "比如说在商场中"
    },
    {
      "start": 345.96000000000004,
      "end": 347.08,
      "text": "你处于略事"
    },
    {
      "start": 347.08,
      "end": 348.24,
      "text": "但是你可以学习"
    },
    {
      "start": 348.24,
      "end": 349.96000000000004,
      "text": "把简单的问题复杂化"
    },
    {
      "start": 349.96000000000004,
      "end": 351.52,
      "text": "也就是把局势搅乱"
