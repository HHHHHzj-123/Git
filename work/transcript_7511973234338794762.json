    {
      "start": 260.52,
      "end": 261.36,
      "text": "有个别的处理方式"
    },
    {
      "start": 261.36,
      "end": 262.72,
      "text": "但总体你可以"
    },
    {
      "start": 262.76000000000005,
      "end": 264.0,
      "text": "就是这三不原则"
    },
    {
      "start": 264.0,
      "end": 265.16,
      "text": "你可以去掌握一下"
    },
    {
      "start": 265.16,
      "end": 265.6,
      "text": "第二"
    },
    {
      "start": 265.6,
      "end": 266.40000000000003,
      "text": "就是外在"
    },
    {
      "start": 266.40000000000003,
      "end": 267.76000000000005,
      "text": "外在的部分叫什么"
    },
    {
      "start": 267.76000000000005,
      "end": 268.64000000000004,
      "text": "叫做派"
    },
    {
      "start": 268.64000000000004,
      "end": 269.6,
      "text": "这很重要"
    },
    {
      "start": 269.6,
      "end": 270.64000000000004,
      "text": "有些人天生病好"
    },
    {
      "start": 270.64000000000004,
      "end": 272.0,
      "text": "出生在一个有视野"
    },
    {
      "start": 272.0,
      "end": 273.52000000000004,
      "text": "这个有格局的家庭中"
    },
    {
      "start": 273.52000000000004,
      "end": 275.8,
      "text": "那么他从小而如木然"
    },
    {
      "start": 275.8,
      "end": 277.32000000000005,
      "text": "他的父母就有做派"
    },
    {
      "start": 277.32000000000005,
      "end": 278.48,
      "text": "所以这种孩子"
    },
    {
      "start": 278.48,
      "end": 279.32000000000005,
      "text": "他一出生"
    },
    {
      "start": 279.32000000000005,
      "end": 280.40000000000003,
      "text": "他就自带做派"
    },
    {
      "start": 280.40000000000003,
      "end": 281.92,
      "text": "如果你家庭出生不好"
    },
    {
      "start": 281.92,
      "end": 282.84000000000003,
      "text": "没关系"
    },
    {
      "start": 282.84000000000003,
      "end": 284.8,
      "text": "依然后天可以"
