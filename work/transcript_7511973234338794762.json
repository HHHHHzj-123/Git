    {
      "start": 253.88,
      "end": 254.56,
      "text": "不争辩"
    },
    {
      "start": 254.56,
      "end": 255.08,
      "text": "不自证"
    },
    {
      "start": 255.08,
      "end": 255.8,
      "text": "没意义"
    },
    {
      "start": 255.8,
      "end": 257.44,
      "text": "因为它已经对你没有信任了"
    },
    {
      "start": 257.44,
      "end": 259.28,
      "text": "一切用行动说话"
    },
    {
      "start": 259.28,
      "end": 260.52,
      "text": "当然个别的情况下"
