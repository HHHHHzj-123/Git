    {
      "start": 284.8,
      "end": 285.8,
      "text": "锻炼和普通"
    },
    {
      "start": 285.8,
      "end": 287.0,
      "text": "就是模仿"
    },
    {
      "start": 287.0,
      "end": 287.52000000000004,
      "text": "就回来了"
    },
    {
      "start": 287.52000000000004,
      "end": 289.52000000000004,
      "text": "模仿永远是你的便捷法门"
    },
    {
      "start": 289.52000000000004,
      "end": 291.48,
      "text": "要模仿高手的眼神"
    },
    {
      "start": 291.52000000000004,
      "end": 292.68,
      "text": "眼神要坚定"
