    {
      "start": 300.48,
      "end": 302.16,
      "text": "一种是要跟对方干架"
    },
    {
      "start": 302.16,
      "end": 302.96000000000004,
      "text": "你到公司里"
    },
    {
      "start": 302.96000000000004,
      "end": 304.52000000000004,
      "text": "你又不是说跟人谈恋爱的"
    },
    {
      "start": 304.52000000000004,
      "end": 305.64000000000004,
      "text": "也不知道跟人干架的"
    },
    {
      "start": 305.64000000000004,
      "end": 307.24,
      "text": "你要是尊重对方"
    },
    {
      "start": 307.24,
      "end": 308.40000000000003,
      "text": "对方是你的领导"
    },
    {
      "start": 308.40000000000003,
      "end": 310.20000000000005,
      "text": "一般是眉间往下一点"
    },
    {
      "start": 310.20000000000005,
      "end": 311.16,
      "text": "这个位置"
    },
    {
      "start": 311.16,
      "end": 312.76,
      "text": "不要死盯着人家眼睛"
    },
    {
      "start": 312.76,
      "end": 313.8,
      "text": "再比如说腔调"
    },
    {
      "start": 313.8,
      "end": 315.24,
