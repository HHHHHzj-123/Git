{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 2.12,
      "text": "快捷核算变得越来越不重要"
    },
    {
      "start": 2.12,
      "end": 3.52,
      "text": "未来大家要学习的是"
    },
    {
      "start": 3.52,
      "end": 5.04,
      "text": "财务管理思路和策略了"
    },
    {
      "start": 5.04,
      "end": 6.2,
      "text": "这是高手必备"
    },
    {
      "start": 6.2,
      "end": 7.6000000000000005,
      "text": "财务它是一个逻辑"
    },
    {
      "start": 7.6000000000000005,
      "end": 8.84,
      "text": "要有底层逻辑的"
    },
    {
      "start": 8.84,
      "end": 11.68,
      "text": "我一直把财务管理分为6大模块"
    },
    {
      "start": 11.68,
      "end": 13.0,
      "text": "现在有很多主播"
    },
    {
      "start": 13.0,
      "end": 15.040000000000001,
      "text": "抄袭我的6大模块"
    },
    {
      "start": 15.040000000000001,
      "end": 16.4,
      "text": "这个是我独家的"
    },
    {
      "start": 16.4,
      "end": 18.400000000000002,
      "text": "我的书是2022年就开始出版了"
    },
    {
      "start": 18.400000000000002,
      "end": 19.28,
      "text": "上面就已经有了"
    },
    {
      "start": 19.28,
      "end": 20.2,
      "text": "我先给你讲一讲"
    },
    {
      "start": 20.2,
      "end": 21.56,
      "text": "为什么是6大模块"
    },
    {
      "start": 21.56,
      "end": 22.96,
      "text": "第一个模块是什么"
    },
    {
      "start": 22.96,
      "end": 25.04,
      "text": "快捷核算和财务思维的差异"
    },
    {
      "start": 25.04,
      "end": 25.84,
      "text": "快捷核算"
    },
    {
      "start": 25.84,
      "end": 27.68,
      "text": "它是一个数据收集的过程"
    },
    {
      "start": 27.72,
      "end": 29.28,
      "text": "然后核算的准确器"
    },
    {
      "start": 29.28,
      "end": 31.4,
      "text": "充分便于进入到下一个模块"
    },
    {
      "start": 31.4,
      "end": 32.4,
      "text": "做财务分析"
    },
    {
      "start": 32.4,
      "end": 34.12,
      "text": "就像是一个医生开命"
    },
    {
      "start": 34.12,
      "end": 35.64,
      "text": "可以开出很多检查单栏"
    },
    {
      "start": 35.64,
      "end": 36.96,
      "text": "其中比如有血肠规压"
    },
    {
      "start": 36.96,
      "end": 37.72,
      "text": "避超一类的"
    },
    {
      "start": 37.72,
      "end": 39.2,
      "text": "它是根据什么来判断"
    },
    {
      "start": 39.2,
      "end": 40.64,
      "text": "你身体有没有问题呢"
    },
    {
      "start": 40.64,
      "end": 42.44,
      "text": "根据这些指标 对吧"
    },
    {
      "start": 42.44,
      "end": 44.04,
      "text": "你的病症在哪"
    },
    {
      "start": 44.04,
      "end": 46.36,
      "text": "有一个标准范围和标准指标"
    },
    {
      "start": 46.36,
      "end": 48.04,
      "text": "其实是行业比率"
    },
    {
      "start": 48.04,
      "end": 48.84,
      "text": "你要不知道"
    },
    {
      "start": 48.84,
      "end": 50.28,
      "text": "同行业的毛率率 净率率"
    },
    {
      "start": 50.28,
      "end": 52.44,
      "text": "那你其实很难做财务分析"
    },
    {
      "start": 52.44,
      "end": 54.120000000000005,
      "text": "其实是跟医生一样的"
    },
    {
      "start": 54.120000000000005,
      "end": 55.96,
      "text": "所以我们做财务分析"
    },
    {
      "start": 55.96,
      "end": 57.56,
      "text": "一定是先横向比"
    },
    {
      "start": 57.6,
      "end": 58.96,
      "text": "横向比是跟谁比"
    },
    {
      "start": 58.96,
      "end": 60.64,
      "text": "同行业竞争对手比"
    },
    {
      "start": 60.64,
      "end": 62.040000000000006,
      "text": "然后才是纵向比"
    },
    {
      "start": 62.040000000000006,
      "end": 63.96,
      "text": "比如说我把公司三年的"
    },
    {
      "start": 63.96,
      "end": 66.04,
      "text": "利润表的数字放出来"
    },
    {
      "start": 66.04,
      "end": 67.88,
      "text": "然后投币还比预算比"
    },
    {
      "start": 67.88,
      "end": 69.96000000000001,
      "text": "然后再查三维看三代"
    },
    {
      "start": 69.96000000000001,
      "end": 71.24000000000001,
      "text": "这个我们都是一套"
    },
    {
      "start": 71.24000000000001,
      "end": 72.32000000000001,
      "text": "不光中国这么干"
    },
    {
      "start": 72.32000000000001,
      "end": 73.16,
      "text": "国外也怎么干"
    },
    {
      "start": 73.16,
      "end": 74.6,
      "text": "发现了痛点 怎么了"
    },
    {
      "start": 74.6,
      "end": 76.6,
      "text": "同行业的数据太好知道了"
    },
    {
      "start": 76.6,
      "end": 78.04,
      "text": "你身边有快知数所"
    },
    {
      "start": 78.04,
      "end": 79.52000000000001,
      "text": "咨询师他们都知道"
    },
    {
      "start": 79.52000000000001,
      "end": 80.36,
      "text": "同行业的比率"
    },
    {
      "start": 80.36,
      "end": 81.36,
      "text": "每年各个行业"
    },
    {
      "start": 81.36,
      "end": 82.52000000000001,
      "text": "都出自己的比率"
    },
    {
      "start": 82.52000000000001,
      "end": 83.52000000000001,
      "text": "如果你没有这些人"
    },
    {
      "start": 83.52000000000001,
      "end": 85.08,
      "text": "你可以去上述公司"
    },
    {
      "start": 85.08,
      "end": 86.16,
      "text": "看看同行业的"
    },
    {
      "start": 86.16,
      "end": 87.75999999999999,
      "text": "他们的上述公司的报表"
    },
    {
      "start": 87.75999999999999,
      "end": 89.16,
      "text": "那就是对外公布的"
    },
    {
      "start": 89.16,
      "end": 90.8,
      "text": "相应的比率自己算就完了"
    },
    {
      "start": 90.8,
      "end": 91.75999999999999,
      "text": "现在还有AI"
    },
    {
      "start": 91.75999999999999,
      "end": 92.96,
      "text": "AI不是特别准"
    },
    {
      "start": 92.96,
      "end": 94.32,
      "text": "就是你可能需要"
    },
    {
      "start": 94.32,
      "end": 95.28,
      "text": "去诊息判断一下"
    },
    {
      "start": 95.28,
      "end": 96.44,
      "text": "当你发现了问题"
    },
    {
      "start": 96.44,
      "end": 97.2,
      "text": "该怎么解决"
    },
    {
      "start": 97.2,
      "end": 98.03999999999999,
      "text": "第三模块"
    },
    {
      "start": 98.03999999999999,
      "end": 98.75999999999999,
      "text": "第四模块"
    },
    {
      "start": 98.75999999999999,
      "end": 99.44,
      "text": "第五模块"
    },
    {
      "start": 99.44,
      "end": 100.16,
      "text": "第六模块"
    },
    {
      "start": 100.16,
      "end": 101.16,
      "text": "都要干这个"
    },
    {
      "start": 101.16,
      "end": 102.4,
      "text": "就是要第一是"
    },
    {
      "start": 102.4,
      "end": 104.03999999999999,
      "text": "内部控制解决问题"
    },
    {
      "start": 104.03999999999999,
      "end": 105.08,
      "text": "什么叫内部控制"
    },
    {
      "start": 105.08,
      "end": 107.32,
      "text": "流程制度的搭建改革"
    },
    {
      "start": 107.32,
      "end": 108.72,
      "text": "改变游戏规则"
    },
    {
      "start": 108.72,
      "end": 109.92,
      "text": "才能治疗好"
    },
    {
      "start": 109.92,
      "end": 111.03999999999999,
      "text": "提出的问题"
    },
    {
      "start": 111.03999999999999,
      "end": 112.52,
      "text": "就得跟做手术一样"
    },
    {
      "start": 112.52,
      "end": 114.03999999999999,
      "text": "要将拥居挖出"
    },
    {
      "start": 114.03999999999999,
      "end": 115.72,
      "text": "你要对组织结构进行调整"
    },
    {
      "start": 115.76,
      "end": 117.4,
      "text": "要改变商业规则"
    },
    {
      "start": 117.4,
      "end": 118.36,
      "text": "改变流程制度"
    },
    {
      "start": 118.36,
      "end": 119.72,
      "text": "改变人员技效"
    },
    {
      "start": 119.72,
      "end": 121.28,
      "text": "这样企业才能起死回生"
    },
    {
      "start": 121.28,
      "end": 122.24,
      "text": "普通的块子"
    },
    {
      "start": 122.24,
      "end": 123.32,
      "text": "他发现了企业问题"
    },
    {
      "start": 123.32,
      "end": 124.52,
      "text": "他就搭的第一个说法"
    },
    {
      "start": 124.52,
      "end": 125.8,
      "text": "就是我该如何记账"
    },
    {
      "start": 125.8,
      "end": 127.08,
      "text": "但是财务高手会说"
    },
    {
      "start": 127.08,
      "end": 129.28,
      "text": "我该如何改变规则"
    },
    {
      "start": 129.28,
      "end": 129.72,
      "text": "记住"
    },
    {
      "start": 129.72,
      "end": 131.07999999999998,
      "text": "只有改变了游戏规则"
    },
    {
      "start": 131.07999999999998,
      "end": 132.72,
      "text": "你的企业才能翻身"
    },
    {
      "start": 132.72,
      "end": 133.88,
      "text": "全面预算"
    },
    {
      "start": 133.88,
      "end": 136.24,
      "text": "其实是内部控制中的一个工具"
    },
    {
      "start": 136.24,
      "end": 138.68,
      "text": "那老奇为什么要把全面预算"
    },
    {
      "start": 138.68,
      "end": 139.48,
      "text": "单拉出来"
    },
    {
      "start": 139.48,
      "end": 140.8,
      "text": "因为全面预算是公司"
    },
    {
      "start": 140.8,
      "end": 141.6,
      "text": "进行改革的"
    },
    {
      "start": 141.6,
      "end": 142.96,
      "text": "特别重要的一个抓手"
    },
    {
      "start": 142.96,
      "end": 144.68,
      "text": "而且全面预算博大精神"
    },
    {
      "start": 144.68,
      "end": 147.24,
      "text": "它不适合于藏在那个控制里面"
    },
    {
      "start": 147.24,
      "end": 148.84,
      "text": "所以我把调整给拉出来了"
    },
    {
      "start": 148.84,
      "end": 150.8,
      "text": "所以你看这6模块是不是我定的"
    },
    {
      "start": 150.8,
      "end": 152.56,
      "text": "我这里面都有很多小心思"
    },
    {
      "start": 152.56,
      "end": 153.88,
      "text": "魔幌4资金管理"
    },
    {
      "start": 153.88,
      "end": 157.32,
      "text": "如何有效利用资金的预警系统"
    },
    {
      "start": 157.32,
      "end": 159.72,
      "text": "然后企业资金的再生系统"
    },
    {
      "start": 159.72,
      "end": 161.84,
      "text": "还有企业资金短缺了怎么办"
    },
    {
      "start": 161.84,
      "end": 163.04000000000002,
      "text": "资金充裕了怎么办"
    },
    {
      "start": 163.04000000000002,
      "end": 165.08,
      "text": "这都是让企业的资金健康"
    },
    {
      "start": 165.08,
      "end": 167.20000000000002,
      "text": "扭转的一个重要的模块"
    },
    {
      "start": 167.20000000000002,
      "end": 168.88,
      "text": "所以我们也是把它单拿出来"
    },
    {
      "start": 168.88,
      "end": 169.84,
      "text": "叫资金管理"
    },
    {
      "start": 169.84,
      "end": 171.64000000000001,
      "text": "模块5就是税务合规"
    },
    {
      "start": 171.64000000000001,
      "end": 174.52,
      "text": "就是说在税务合规合法的要求下"
    },
    {
      "start": 174.56,
      "end": 175.44,
      "text": "做好事完毕"
    },
    {
      "start": 175.44,
      "end": 177.52,
      "text": "让企业在合理的数据成本下"
    },
    {
      "start": 177.52,
      "end": 178.24,
      "text": "健康发展"
    },
    {
      "start": 178.24,
      "end": 180.72,
      "text": "这个肯定是财税老大必须要考虑的"
    },
    {
      "start": 180.72,
      "end": 182.4,
      "text": "第6就是投资并购"
    },
    {
      "start": 182.4,
      "end": 183.12,
      "text": "融资"
    },
    {
      "start": 183.12,
      "end": 183.68,
      "text": "技术"
    },
    {
      "start": 183.68,
      "end": 185.08,
      "text": "金融这个工具"
    },
    {
      "start": 185.08,
      "end": 186.12,
      "text": "它是一个加速器"
    },
    {
      "start": 186.12,
      "end": 188.32000000000002,
      "text": "它能让你的企业加速成长"
    },
    {
      "start": 188.32000000000002,
      "end": 190.84,
      "text": "同时也能让你的企业加速灭亡"
    },
    {
      "start": 190.84,
      "end": 192.0,
      "text": "你要是用好了"
    },
    {
      "start": 192.0,
      "end": 194.8,
      "text": "那你企业可能原本花10年的时间成长"
    },
    {
      "start": 194.8,
      "end": 196.92000000000002,
      "text": "那可能现在3年一触而就"
    },
    {
      "start": 196.92000000000002,
      "end": 198.32000000000002,
      "text": "但是如果你不会使用"
    },
    {
      "start": 198.32000000000002,
      "end": 199.92000000000002,
      "text": "可能本来还能活10年"
    },
    {
      "start": 199.92000000000002,
      "end": 201.28,
      "text": "现在一年直接狗屁"
    },
    {
      "start": 202.4,
      "end": 204.04000000000002,
      "text": "所以金融这个东西最难"
    },
    {
      "start": 204.04,
      "end": 205.51999999999998,
      "text": "我把它放在第6个模块"
    },
    {
      "start": 205.51999999999998,
      "end": 208.16,
      "text": "也是财务管理中的天花板"
    },
    {
      "start": 208.16,
      "end": 209.95999999999998,
      "text": "投资并购比融资还难"
    },
    {
      "start": 209.95999999999998,
      "end": 212.0,
      "text": "其实上市也是融资的一部分"
    },
    {
      "start": 212.0,
      "end": 213.23999999999998,
      "text": "上市的目的是什么"
    },
    {
      "start": 213.23999999999998,
      "end": 214.92,
      "text": "上市的目的是融资"
    },
    {
      "start": 214.92,
      "end": 218.32,
      "text": "所以投资并购融资涉及的是资本游戏"
    },
    {
      "start": 218.32,
      "end": 219.56,
      "text": "就进入到资本局了"
    },
    {
      "start": 219.56,
      "end": 221.35999999999999,
      "text": "就是说你要学的是财务管理"
    },
    {
      "start": 221.35999999999999,
      "end": 222.28,
      "text": "而不是会计和算"
    },
    {
      "start": 222.28,
      "end": 224.04,
      "text": "那些税法的法条"
    },
    {
      "start": 224.04,
      "end": 224.72,
      "text": "AI有了"
    },
    {
      "start": 224.72,
      "end": 225.44,
      "text": "Deep Sake有了"
    },
    {
      "start": 225.44,
      "end": 226.28,
      "text": "豆包有了"
    },
    {
      "start": 226.28,
      "end": 227.79999999999998,
      "text": "你随时都可以查得出来"
    },
    {
      "start": 227.79999999999998,
      "end": 228.35999999999999,
      "text": "不是吗"
    },
    {
      "start": 228.35999999999999,
      "end": 230.23999999999998,
      "text": "会计和算变得越来越不重要"
    },
    {
      "start": 230.23999999999998,
      "end": 230.76,
      "text": "记住"
    },
    {
      "start": 230.76,
      "end": 231.6,
      "text": "会计和出纳"
    },
    {
      "start": 231.6,
      "end": 235.12,
      "text": "它只是收集数据的收集人员"
    },
    {
      "start": 235.12,
      "end": 236.0,
      "text": "没什么可能"
    },
    {
      "start": 236.0,
      "end": 237.84,
      "text": "只要负责认真仔细"
    },
    {
      "start": 237.84,
      "end": 239.07999999999998,
      "text": "就谁都能干"
    },
    {
      "start": 239.07999999999998,
      "end": 240.48,
      "text": "所以你不要死报"
    },
    {
      "start": 240.48,
      "end": 241.56,
      "text": "快点和算这点事"
    },
    {
      "start": 241.56,
      "end": 242.35999999999999,
      "text": "业财融合"
    },
    {
      "start": 242.35999999999999,
      "end": 243.76,
      "text": "并应该是财务老大干的事"
    },
    {
      "start": 243.76,
      "end": 245.24,
      "text": "我已经中告了很多次了"
    },
    {
      "start": 245.24,
      "end": 247.4,
      "text": "所以未来大家要学习的是财务管理"
    },
    {
      "start": 247.4,
      "end": 248.24,
      "text": "思路和策略"
    },
    {
      "start": 248.24,
      "end": 250.51999999999998,
      "text": "重要的是财务思维和沟通能力"
    },
    {
      "start": 250.51999999999998,
      "end": 253.35999999999999,
      "text": "这样你能不能帮企业出主意解决问题"
    },
    {
      "start": 253.35999999999999,
      "end": 255.2,
      "text": "还有你对上对下的沟通能力"
    },
    {
      "start": 255.2,
      "end": 256.04,
      "text": "是一定要记住"
    },
    {
      "start": 256.04,
      "end": 258.76,
      "text": "销售部是给你拿业绩的那个人"
    },
    {
