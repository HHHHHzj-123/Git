    {
      "start": 200.79999999999998,
      "end": 202.79999999999998,
      "text": "然后是禁销存的软件"
    },
    {
      "start": 202.79999999999998,
      "end": 203.79999999999998,
      "text": "不一定上ERP"
    },
    {
      "start": 203.8,
