    },
    {
      "start": 129.2,
      "end": 131.0,
      "text": "到底哪些在线上预售"
    },
    {
      "start": 131.0,
      "end": 132.4,
      "text": "哪些不在线上预售"
    },
    {
      "start": 132.4,
      "end": 134.2,
      "text": "它也是要进行挑选的"
