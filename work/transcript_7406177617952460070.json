    {
      "start": 95.2,
      "end": 96.0,
      "text": "跟我说了"
    },
    {
      "start": 96.0,
      "end": 97.6,
      "text": "服装企业主要考两个"
    },
    {
      "start": 97.6,
      "end": 98.39999999999999,
      "text": "一个是产品"
    },
    {
      "start": 98.39999999999999,
      "end": 99.39999999999999,
      "text": "还有一个是库存"
    },
    {
      "start": 99.39999999999999,
      "end": 100.39999999999999,
      "text": "库存很重要"
    },
    {
      "start": 100.39999999999999,
      "end": 102.8,
      "text": "而在线上能做到的是预售"
    },
    {
      "start": 102.8,
      "end": 104.2,
      "text": "线上经常放出来的"
    },
    {
      "start": 104.2,
      "end": 105.6,
      "text": "通常是打板的样衣"
    },
    {
      "start": 105.6,
      "end": 106.8,
      "text": "它还没有批量生产"
    },
    {
      "start": 106.8,
      "end": 109.0,
      "text": "它要看这些样衣上线了以后"
