    {
      "start": 163.8,
      "end": 164.60000000000002,
      "text": "叫快反"
    },
    {
      "start": 164.60000000000002,
      "end": 165.60000000000002,
      "text": "快速反应能力"
    },
    {
      "start": 165.60000000000002,
      "end": 166.60000000000002,
      "text": "你的产品部"
    },
    {
      "start": 166.60000000000002,
      "end": 167.20000000000002,
      "text": "研发部"
    },
    {
      "start": 167.20000000000002,
      "end": 168.00000000000003,
      "text": "销售部"
    },
    {
      "start": 168.00000000000003,
      "end": 169.8,
