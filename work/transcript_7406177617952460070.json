    {
      "start": 119.2,
      "end": 120.6,
      "text": "是不是做的就是一销定产"
    },
    {
      "start": 120.6,
      "end": 121.39999999999999,
      "text": "小米苏期"
    },
    {
      "start": 121.39999999999999,
      "end": 122.39999999999999,
      "text": "是不是先交钱"
    },
    {
      "start": 122.39999999999999,
      "end": 123.6,
      "text": "后交货 对不对"
    },
    {
      "start": 123.6,
      "end": 124.2,
      "text": "首先第一"
    },
    {
      "start": 124.2,
      "end": 125.2,
      "text": "我还是要强调"
    },
    {
      "start": 125.2,
      "end": 126.0,
