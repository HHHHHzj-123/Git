{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 2.44,
      "text": "好多人想让我讲餐饮行业"
    },
    {
      "start": 2.44,
      "end": 4.32,
      "text": "不光要讲管理中的重点"
    },
    {
      "start": 4.32,
      "end": 5.92,
      "text": "还要讲核算中的重点"
    },
    {
      "start": 5.92,
      "end": 8.52,
      "text": "好的财务干架确实是不一样的"
    },
    {
      "start": 8.52,
      "end": 9.4,
      "text": "平海银峰同学"
    },
    {
      "start": 9.4,
      "end": 11.8,
      "text": "做了14年的餐饮行业的财务老大"
    },
    {
      "start": 11.8,
      "end": 14.32,
      "text": "他在餐饮行业里面什么岗位都做过"
    },
    {
      "start": 14.32,
      "end": 15.48,
      "text": "甚至做过服务员"
    },
    {
      "start": 15.48,
      "end": 17.84,
      "text": "我们说了财务管理部分行业"
    },
    {
      "start": 17.84,
      "end": 19.92,
      "text": "财务核算他是分行业的"
    },
    {
      "start": 19.92,
      "end": 22.32,
      "text": "不同的行业会有不同的核算方式"
    },
    {
      "start": 22.32,
      "end": 23.080000000000002,
      "text": "首先我们先说"
    },
    {
      "start": 23.080000000000002,
      "end": 26.04,
      "text": "北京和上海的餐饮业下滑的速度非常之快"
    },
    {
      "start": 26.04,
      "end": 29.12,
      "text": "北京成规模的餐饮行业进行了统计"
    },
    {
      "start": 29.12,
      "end": 30.200000000000003,
      "text": "什么叫成规模"
    },
    {
      "start": 30.200000000000003,
      "end": 34.480000000000004,
      "text": "也就是说年营收在200万以上的餐厅进行了统计"
    },
    {
      "start": 34.480000000000004,
      "end": 37.4,
      "text": "进利润和去年统比下滑88%"
    },
    {
      "start": 37.4,
      "end": 40.96,
      "text": "上海成规模的餐饮行业进利润是亏损的"
    },
    {
      "start": 40.96,
      "end": 43.36,
      "text": "近年来为什么餐饮行业表现不好"
    },
    {
      "start": 43.36,
      "end": 44.120000000000005,
      "text": "有几个原因"
    },
    {
      "start": 44.120000000000005,
      "end": 45.760000000000005,
      "text": "第一门槛低这个行业"
    },
    {
      "start": 45.760000000000005,
      "end": 46.92,
      "text": "大家都往里挤"
    },
    {
      "start": 46.92,
      "end": 51.28,
      "text": "第二餐饮行业它其实运营环节非常多"
    },
    {
      "start": 51.28,
      "end": 53.28,
      "text": "而且需要精耕细作"
    },
    {
      "start": 53.28,
      "end": 54.32,
      "text": "但很多人做不到"
    },
    {
      "start": 54.32,
      "end": 58.040000000000006,
      "text": "第三三年疫情吃掉了很多餐饮行业的利润"
    },
    {
      "start": 58.08,
      "end": 59.32,
      "text": "第四低价竞争"
    },
    {
      "start": 59.32,
      "end": 62.32,
      "text": "导致餐饮行业盈利变得缝毛领脚"
    },
    {
      "start": 62.32,
      "end": 65.4,
      "text": "第五商业街的房租的租金上涨"
    },
    {
      "start": 65.4,
      "end": 66.52,
      "text": "我说的是商业街的"
    },
    {
      "start": 66.52,
      "end": 67.6,
      "text": "那么做好餐饮"
    },
    {
      "start": 67.6,
      "end": 69.6,
      "text": "我们必须得知道定位和经营"
    },
    {
      "start": 69.6,
      "end": 71.36,
      "text": "是非常重要的一件事情"
    },
    {
      "start": 71.36,
      "end": 73.56,
      "text": "我们大致给它分为高端餐饮"
    },
    {
      "start": 73.56,
      "end": 75.64,
      "text": "中端餐饮和大中化餐饮"
    },
    {
      "start": 75.64,
      "end": 79.24,
      "text": "我们通常认为人均消费在500以上的"
    },
    {
      "start": 79.24,
      "end": 80.48,
      "text": "都算是高端餐饮"
    },
    {
      "start": 80.48,
      "end": 81.96000000000001,
      "text": "人均消费100到300的"
    },
    {
      "start": 81.96000000000001,
      "end": 83.03999999999999,
      "text": "这属于中端的"
    },
    {
      "start": 83.03999999999999,
      "end": 84.36,
      "text": "那么大中化的餐饮"
    },
    {
      "start": 84.36,
      "end": 85.84,
      "text": "也就是我们讲的经济型的"
    },
    {
      "start": 85.84,
      "end": 88.44,
      "text": "通常消费人均不超过100"
    },
    {
      "start": 88.44,
      "end": 90.04,
      "text": "餐饮行业的毛利率是多少"
    },
    {
      "start": 90.04,
      "end": 92.16,
      "text": "记住行业毛利率60%"
    },
    {
      "start": 92.16,
      "end": 94.24000000000001,
      "text": "如果是50%到60%"
    },
    {
      "start": 94.24000000000001,
      "end": 95.24000000000001,
      "text": "是在危险期"
    },
    {
      "start": 95.24000000000001,
      "end": 96.04,
      "text": "我们这个学员"
    },
    {
      "start": 96.04,
      "end": 98.48,
      "text": "他曾经在一个星期酒店"
    },
    {
      "start": 98.48,
      "end": 99.56,
      "text": "做这个财务总监"
    },
    {
      "start": 99.56,
      "end": 100.48,
      "text": "其实之前呢"
    },
    {
      "start": 100.48,
      "end": 101.84,
      "text": "被开掉了一个财务总监"
    },
    {
      "start": 101.84,
      "end": 102.60000000000001,
      "text": "他了解了一下"
    },
    {
      "start": 102.60000000000001,
      "end": 104.52000000000001,
      "text": "就是因为之前的那个财务总监"
    },
    {
      "start": 104.52000000000001,
      "end": 105.32000000000001,
      "text": "啥也没做"
    },
    {
      "start": 105.32000000000001,
      "end": 105.92,
      "text": "工作呢"
    },
    {
      "start": 105.92,
      "end": 106.64,
      "text": "违背说说"
    },
    {
      "start": 106.64,
      "end": 108.12,
      "text": "没有任何的业绩"
    },
    {
      "start": 108.12,
      "end": 109.12,
      "text": "后来就被开除了"
    },
    {
      "start": 109.12,
      "end": 110.92,
      "text": "这个餐厅是一个单一的股东"
    },
    {
      "start": 110.92,
      "end": 112.32000000000001,
      "text": "如果餐厅是单一股东"
    },
    {
      "start": 112.32000000000001,
      "end": 113.60000000000001,
      "text": "这是非常好的一件事情"
    },
    {
      "start": 113.60000000000001,
      "end": 115.08000000000001,
      "text": "股东后来非常喜欢"
    },
    {
      "start": 115.08,
      "end": 115.92,
      "text": "平海林峰同学"
    },
    {
      "start": 115.92,
      "end": 116.84,
      "text": "以及重视他"
    },
    {
      "start": 116.84,
      "end": 117.52,
      "text": "就是因为"
    },
    {
      "start": 117.52,
      "end": 119.08,
      "text": "首先他干的第一件事情"
    },
    {
      "start": 119.08,
      "end": 121.08,
      "text": "就是和供应商压价格"
    },
    {
      "start": 121.08,
      "end": 122.12,
      "text": "做采购管理"
    },
    {
      "start": 122.12,
      "end": 123.03999999999999,
      "text": "采购管理怎么做"
    },
    {
      "start": 123.03999999999999,
      "end": 123.88,
      "text": "一个财务总监"
    },
    {
      "start": 123.88,
      "end": 124.52,
      "text": "怎么压价"
    },
    {
      "start": 124.52,
      "end": 126.12,
      "text": "我们来看看你的执行能力"
    },
    {
      "start": 126.12,
      "end": 127.4,
      "text": "你怎么去给餐厅压价"
    },
    {
      "start": 127.4,
      "end": 128.68,
      "text": "你能不能走出去"
    },
    {
      "start": 128.68,
      "end": 130.32,
      "text": "你能不能跟别人约谈"
    },
    {
      "start": 130.32,
      "end": 131.72,
      "text": "请问你有真的"
    },
    {
      "start": 131.72,
      "end": 132.96,
      "text": "跟供应商谈过判吗"
    },
    {
      "start": 132.96,
      "end": 134.28,
      "text": "就是把供应商"
    },
    {
      "start": 134.28,
      "end": 136.16,
      "text": "一家一家的约谈过来"
    },
    {
      "start": 136.16,
      "end": 137.44,
      "text": "因为他被靠着一个"
    },
    {
      "start": 137.44,
      "end": 139.28,
      "text": "比较高端的参议集团"
    },
    {
      "start": 139.28,
      "end": 140.12,
      "text": "所以好谈判"
    },
    {
      "start": 140.12,
      "end": 141.36,
      "text": "高价的食材"
    },
    {
      "start": 141.36,
      "end": 142.52,
      "text": "通常供应商"
    },
    {
      "start": 142.52,
      "end": 144.44,
      "text": "都会留的比较多的毛利"
    },
    {
      "start": 144.44,
      "end": 145.60000000000002,
      "text": "多找几家"
    },
    {
      "start": 145.60000000000002,
      "end": 147.12,
      "text": "进行报价和对比"
    },
    {
      "start": 147.12,
      "end": 147.84,
      "text": "摸底"
    },
    {
      "start": 147.84,
      "end": 149.32000000000002,
      "text": "同时还要摸清"
    },
    {
      "start": 149.32000000000002,
      "end": 152.0,
      "text": "供应商他们的毛利率情况"
    },
    {
      "start": 152.0,
      "end": 152.92000000000002,
      "text": "压价格的同时"
    },
    {
      "start": 152.92000000000002,
      "end": 153.96,
      "text": "要给对方留利润"
    },
    {
      "start": 153.96,
      "end": 156.24,
      "text": "他认为做中高端餐饮"
    },
    {
      "start": 156.24,
      "end": 158.52,
      "text": "从供应商那压3%的毛利"
    },
    {
      "start": 158.52,
      "end": 160.28,
      "text": "是铁定能压得出来的"
    },
    {
      "start": 160.28,
      "end": 161.44,
      "text": "如果你摸不到底"
    },
    {
      "start": 161.44,
      "end": 162.68,
      "text": "你就往下降2%"
    },
    {
      "start": 162.68,
      "end": 163.0,
      "text": "行不行"
    },
    {
      "start": 163.0,
      "end": 164.36,
      "text": "你只要降2%"
    },
    {
      "start": 164.36,
      "end": 166.32000000000002,
      "text": "你的毛利是不是上涨2%"
    },
    {
      "start": 166.32000000000002,
      "end": 168.08,
      "text": "这不就是你财务部的贡献吗"
    },
    {
      "start": 168.08,
      "end": 170.64000000000001,
      "text": "再说他在优化的供应商过程中"
    },
    {
      "start": 170.64000000000001,
      "end": 171.56,
      "text": "还可以考虑一个"
    },
    {
      "start": 171.56,
      "end": 173.2,
      "text": "叫提前支出货款"
    },
    {
      "start": 173.2,
      "end": 175.44,
      "text": "通常这也是我们压价的一个方式"
    },
    {
      "start": 175.44,
      "end": 176.76,
      "text": "就是我不给你涨期"
    },
    {
      "start": 176.76,
      "end": 178.12,
      "text": "我现结给我打折"
    },
    {
      "start": 178.12,
      "end": 179.76,
      "text": "这个通常是在公司资金"
    },
    {
      "start": 179.76,
      "end": 181.08,
      "text": "有比较充裕的情况下"
    },
    {
      "start": 181.08,
      "end": 182.96,
      "text": "现在的活期利率这么低"
    },
    {
      "start": 182.96,
      "end": 183.92000000000002,
      "text": "你哥在账上"
    },
    {
      "start": 183.92000000000002,
      "end": 185.44,
      "text": "请问他能产生多少收益"
    },
    {
      "start": 185.44,
      "end": 188.16,
      "text": "如果你没有再去做理财和增值的"
    },
    {
      "start": 188.16,
      "end": 188.8,
      "text": "考虑的话"
    },
    {
      "start": 188.8,
      "end": 190.4,
      "text": "你为什么不能现结"
    },
    {
      "start": 190.4,
      "end": 191.4,
      "text": "如果你现结打折"
    },
    {
      "start": 191.4,
      "end": 192.6,
      "text": "能够打到13%"
    },
    {
      "start": 192.6,
      "end": 193.48000000000002,
      "text": "你不就相当于"
    },
    {
      "start": 193.48000000000002,
      "end": 195.04,
      "text": "拿到了13%的理财吗"
    },
    {
      "start": 195.04,
      "end": 195.84,
      "text": "我就不知道"
    },
    {
      "start": 195.84,
      "end": 197.52,
      "text": "有的财务人员非常固执的"
    },
    {
      "start": 197.52,
      "end": 199.68,
      "text": "认为只要拖应付的时间"
    },
    {
      "start": 199.68,
      "end": 200.84,
      "text": "拖延的越长越好"
    },
    {
      "start": 200.84,
      "end": 201.76,
      "text": "我认为不是"
    },
    {
      "start": 201.76,
      "end": 203.4,
      "text": "那是因为你没钱的情况下"
    },
    {
      "start": 203.4,
      "end": 204.56,
      "text": "如果你提前结账"
    },
    {
      "start": 204.56,
      "end": 205.48,
      "text": "能够拿到折扣"
    },
    {
      "start": 205.48,
      "end": 206.76,
      "text": "那我认为应该早结"
    },
    {
      "start": 206.76,
      "end": 208.24,
      "text": "而且你拉得越长"
    },
    {
      "start": 208.24,
      "end": 210.0,
      "text": "你的工医商就越不喜欢你"
    },
    {
      "start": 210.0,
      "end": 211.16,
      "text": "对你越没有粘性"
    },
    {
      "start": 211.16,
      "end": 213.2,
      "text": "平海灵丰他所在的餐饮"
    },
    {
      "start": 213.2,
      "end": 214.52,
      "text": "就是他做过的餐饮店"
    },
    {
      "start": 214.52,
      "end": 215.48000000000002,
      "text": "基本上毛利"
    },
    {
      "start": 215.48000000000002,
      "end": 217.72,
      "text": "都是在63%到65%"
    },
    {
      "start": 217.72,
      "end": 218.28,
      "text": "你要知道"
    },
    {
      "start": 218.28,
      "end": 220.12,
      "text": "如果这个是连锁门店"
    },
    {
      "start": 220.12,
      "end": 221.88,
      "text": "他的流水很大的话"
    },
    {
      "start": 221.88,
      "end": 223.32,
      "text": "连销售额是一个亿"
    },
    {
      "start": 223.32,
      "end": 225.96,
      "text": "你节约出来1%的毛利"
    },
    {
      "start": 225.96,
      "end": 226.84,
      "text": "那这100万"
    },
    {
      "start": 226.84,
      "end": 229.0,
      "text": "是不是就是财务部带来的"
    },
    {
      "start": 229.0,
      "end": 230.6,
      "text": "你的业绩不就出来了吗"
    },
    {
      "start": 230.6,
      "end": 233.12,
      "text": "你为老板带来了100万的净利润"
    },
    {
      "start": 233.12,
      "end": 234.16,
      "text": "谁还敢把你轰走"
    },
    {
      "start": 234.16,
      "end": 234.88,
      "text": "如果你说"
    },
    {
      "start": 234.88,
      "end": 237.0,
      "text": "老师这个应该总经理去谈"
    },
    {
      "start": 237.0,
      "end": 238.48,
      "text": "或者是采购部去谈"
    },
    {
      "start": 238.48,
      "end": 241.32,
      "text": "请问人家在技校业绩汇报的时候"
    },
    {
      "start": 241.32,
      "end": 243.35999999999999,
      "text": "人说我我给公司省了100万"
    },
    {
      "start": 243.35999999999999,
      "end": 244.16,
      "text": "有你啥事"
    },
    {
      "start": 244.16,
      "end": 245.79999999999998,
      "text": "现在你财务部给谈下来的"
    },
    {
      "start": 245.79999999999998,
      "end": 247.48,
      "text": "请问你是不是可以"
    },
    {
      "start": 247.48,
      "end": 248.79999999999998,
      "text": "年终的时候跟老板说"
    },
    {
      "start": 248.79999999999998,
      "end": 250.16,
      "text": "老板我省出了100万"
    },
    {
      "start": 250.16,
      "end": 252.76,
      "text": "能不能给我们办公室发个奖金"
    },
    {
      "start": 252.76,
      "end": 253.92,
      "text": "好 我的这个学员"
    },
    {
      "start": 253.92,
      "end": 256.76,
      "text": "他还去过另外一个餐饮集团"
    },
    {
      "start": 256.76,
      "end": 258.68,
      "text": "在采购贪腐的这个问题上"
    },
    {
      "start": 258.76,
      "end": 260.6,
      "text": "你看看我这个学员是怎么解决的"
    },
    {
      "start": 260.6,
      "end": 262.2,
      "text": "大部分采购人员他发现"
    },
    {
      "start": 262.2,
      "end": 264.04,
      "text": "都是老板的亲信或者发小"
    },
    {
      "start": 264.04,
      "end": 266.08,
      "text": "这是很多民企都出现的问题"
    },
    {
      "start": 266.08,
      "end": 268.28000000000003,
      "text": "要不然就是自己最信都过的兄弟"
    },
    {
      "start": 268.28000000000003,
      "end": 269.6,
      "text": "这家餐饮集团呢"
    },
    {
      "start": 269.6,
      "end": 270.8,
      "text": "用的这个采购人员"
    },
    {
      "start": 270.8,
      "end": 273.68,
      "text": "其实是老板最信任的兄弟一起长大"
    },
    {
      "start": 273.68,
      "end": 274.6,
      "text": "都是当地人"
    },
    {
      "start": 274.6,
      "end": 275.0,
      "text": "记住"
    },
    {
      "start": 275.0,
      "end": 276.88,
      "text": "其实越是这些亲信和发小"
    },
    {
      "start": 276.88,
      "end": 277.44,
      "text": "越可怕"
    },
    {
      "start": 277.44,
      "end": 278.8,
      "text": "因为你发现了他们贪腐"
    },
    {
      "start": 278.8,
      "end": 280.48,
      "text": "你开厨都不好开厨知道吧"
    },
    {
      "start": 280.48,
      "end": 281.32,
      "text": "这个餐厅呢"
    },
    {
      "start": 281.32,
      "end": 283.28000000000003,
      "text": "一天营业24个小时"
    },
    {
      "start": 283.28000000000003,
      "end": 284.12,
      "text": "那你说呢"
    },
    {
      "start": 284.12,
      "end": 284.96000000000004,
      "text": "应该很挣钱"
    },
    {
      "start": 284.96000000000004,
      "end": 286.36,
      "text": "但是利润一直上不来"
    },
    {
      "start": 286.36,
      "end": 287.92,
      "text": "这个平海林峰近来一个月"
    },
    {
      "start": 287.96000000000004,
      "end": 289.68,
      "text": "他就开始和供应商对账"
    },
    {
      "start": 289.68,
      "end": 291.6,
      "text": "发现了采购的贪腐"
    },
    {
      "start": 291.6,
      "end": 293.92,
      "text": "供应商提供跟餐厅的账号"
    },
    {
      "start": 293.92,
      "end": 295.24,
      "text": "但是这个采购人员"
    },
    {
      "start": 295.24,
      "end": 297.6,
      "text": "他没有把这些账号给到公司"
    },
    {
      "start": 297.6,
      "end": 299.92,
      "text": "而是给了公司另外的一堆账号"
    },
    {
      "start": 299.92,
      "end": 302.76,
      "text": "这个也不是采购人员自己名字的账号"
    },
    {
      "start": 302.76,
      "end": 304.64,
      "text": "他背后控制着这些账号"
    },
    {
      "start": 304.64,
      "end": 306.48,
      "text": "也就是说公司支付这些货款"
    },
    {
      "start": 306.48,
      "end": 308.24,
      "text": "是支付到采购人员"
    },
    {
      "start": 308.24,
      "end": 309.68,
      "text": "他控制的账号里面"
    },
    {
      "start": 309.68,
      "end": 310.88,
      "text": "然后采购人员"
    },
    {
      "start": 310.88,
      "end": 312.56,
      "text": "在支付给供应商的时候"
    },
    {
      "start": 312.56,
      "end": 314.24,
      "text": "扣下了差价"
    },
    {
      "start": 314.24,
      "end": 314.88,
      "text": "怎么发现"
    },
    {
      "start": 314.88,
      "end": 317.12,
      "text": "跟供应商一堆账不就发现了吗"
    },
    {
      "start": 317.12,
      "end": 318.2,
      "text": "当时算了一下"
    },
    {
      "start": 318.2,
      "end": 319.64,
      "text": "就他来的这个一个月"
    },
    {
      "start": 319.64,
      "end": 321.56,
      "text": "这个采购人员就贪污了八万块钱"
    },
    {
      "start": 321.56,
      "end": 322.76,
      "text": "以前可能贪污的更多"
    },
    {
      "start": 322.76,
      "end": 324.8,
      "text": "然后采购人员直接就跑路了"
    },
    {
      "start": 325.88,
      "end": 327.04,
      "text": "连敌职都没离职"
    },
    {
      "start": 327.04,
      "end": 329.36,
      "text": "但是我们这个学员的下场也不大好"
    },
    {
      "start": 329.36,
      "end": 331.48,
      "text": "因为后来得罪了太多的人被孤立"
    },
    {
      "start": 331.48,
      "end": 333.04,
      "text": "最后他被迫辞职"
    },
    {
      "start": 333.04,
      "end": 335.8,
      "text": "您我们喜欢的是拉一波打一波"
    },
    {
      "start": 335.8,
      "end": 336.32,
      "text": "记住啊"
    },
    {
      "start": 336.32,
      "end": 337.32,
      "text": "千万别被孤立"
    },
    {
      "start": 337.32,
      "end": 339.0,
      "text": "拉一波打一波的时候"
    },
    {
      "start": 339.0,
      "end": 339.68,
      "text": "你要小心"
    },
    {
      "start": 339.68,
      "end": 341.0,
      "text": "你要拉这一波人"
    },
    {
      "start": 341.0,
      "end": 343.12,
      "text": "你可能要对你拉进来的这波人"
    },
    {
      "start": 343.12,
      "end": 343.92,
      "text": "要睁一只眼"
    },
    {
      "start": 343.92,
      "end": 344.48,
      "text": "闭一只眼"
    },
    {
      "start": 344.48,
      "end": 345.24,
      "text": "你没办法"
    },
    {
      "start": 345.24,
      "end": 345.96,
      "text": "要不然的话"
    },
    {
      "start": 346.0,
      "end": 347.44,
      "text": "大家一起搞你就搞死了"
    },
    {
      "start": 347.44,
      "end": 347.71999999999997,
      "text": "来"
    },
    {
      "start": 347.71999999999997,
      "end": 349.0,
      "text": "那核算中什么最重要"
    },
    {
      "start": 349.0,
      "end": 349.88,
      "text": "重中之重"
    },
    {
      "start": 349.88,
      "end": 350.56,
      "text": "核算中的"
    },
    {
      "start": 350.56,
      "end": 352.71999999999997,
      "text": "必须得把自己的存货和成本"
    },
    {
      "start": 352.71999999999997,
      "end": 354.03999999999996,
      "text": "过核算的准确"
    },
    {
      "start": 354.03999999999996,
      "end": 355.08,
      "text": "这个跑不了"
    },
    {
      "start": 355.08,
      "end": 355.79999999999995,
      "text": "首先第一"
    },
    {
      "start": 355.79999999999995,
      "end": 357.23999999999995,
      "text": "我们先讲经济型的"
    },
    {
      "start": 357.23999999999995,
      "end": 359.28,
      "text": "这种大众型的小的餐饮们念"
    },
    {
      "start": 359.28,
      "end": 362.44,
      "text": "如果你没有一个进销存的软件的话"
    },
    {
      "start": 362.44,
      "end": 363.76,
      "text": "那么通常情况下"
    },
    {
      "start": 363.76,
      "end": 365.15999999999997,
      "text": "成本是倒几出来的"
    },
    {
      "start": 365.15999999999997,
      "end": 365.88,
      "text": "怎么倒几"
    },
    {
      "start": 365.88,
      "end": 368.15999999999997,
      "text": "七出库存加本月采购"
    },
    {
      "start": 368.15999999999997,
      "end": 369.56,
      "text": "减期末库存"
    },
    {
      "start": 369.56,
      "end": 371.56,
      "text": "等于本期发生的成本"
    },
    {
      "start": 371.56,
      "end": 373.28,
      "text": "也就是我们说的营业成本"
    },
    {
      "start": 373.28,
      "end": 375.32,
      "text": "是不是库存盘点"
    },
    {
      "start": 375.32,
      "end": 376.84,
      "text": "就变得非常重要"
    },
    {
      "start": 376.84,
      "end": 378.52,
      "text": "包括库存的安全性"
    },
    {
      "start": 378.52,
      "end": 379.96,
      "text": "是不是就变得非常重要"
    },
    {
      "start": 379.96,
      "end": 381.24,
      "text": "让我们来一点一点讲"
    },
    {
      "start": 381.24,
      "end": 382.12,
      "text": "首先我们先说"
    },
    {
      "start": 382.12,
      "end": 383.71999999999997,
      "text": "参与行业这个成本里面"
    },
    {
      "start": 383.71999999999997,
      "end": 385.4,
      "text": "包括什么成本结构"
    },
    {
      "start": 385.4,
      "end": 386.12,
      "text": "这里我先问"
    },
    {
      "start": 386.12,
      "end": 387.56,
      "text": "包括后厨的"
    },
    {
      "start": 387.56,
      "end": 388.88,
      "text": "这个厨师的工资"
    },
    {
      "start": 388.88,
      "end": 390.24,
      "text": "还有包括后厨的什么"
    },
    {
      "start": 390.24,
      "end": 391.48,
      "text": "这个房租的分摊"
    },
    {
      "start": 391.48,
      "end": 392.6,
      "text": "这个行业中"
    },
    {
      "start": 392.6,
      "end": 394.68,
      "text": "通常营业成本里"
    },
    {
      "start": 394.68,
      "end": 396.96,
      "text": "不包括厨师的工资"
    },
    {
      "start": 396.96,
      "end": 399.03999999999996,
      "text": "和后厨分摊的房租"
    },
    {
      "start": 399.03999999999996,
      "end": 400.28,
      "text": "成本中包含什么"
    },
    {
      "start": 400.28,
      "end": 401.68,
      "text": "食材的成本"
    },
    {
      "start": 401.68,
      "end": 403.68,
      "text": "酒水饮料的成本"
    },
    {
      "start": 403.68,
      "end": 405.04,
      "text": "一次性消耗"
    },
    {
      "start": 405.04,
      "end": 406.40000000000003,
      "text": "品搭成本"
    },
    {
      "start": 406.40000000000003,
      "end": 407.6,
      "text": "处源工资不包括"
    },
    {
      "start": 407.6,
      "end": 408.76,
      "text": "平凯林峰"
    },
    {
      "start": 408.76,
      "end": 409.6,
      "text": "我们这个学员"
    },
    {
      "start": 409.6,
      "end": 410.56,
      "text": "他的库房管理"
    },
    {
      "start": 410.56,
      "end": 411.96,
      "text": "你可能都想象不到"
    },
    {
      "start": 411.96,
      "end": 412.72,
      "text": "但是这里面"
    },
    {
      "start": 412.72,
      "end": 414.56,
      "text": "就体现了一个重要性原则"
    },
    {
      "start": 414.56,
      "end": 415.16,
      "text": "首先第一"
    },
    {
      "start": 415.16,
      "end": 416.84000000000003,
      "text": "对于贵重的食材"
    },
    {
      "start": 416.84000000000003,
      "end": 417.84000000000003,
      "text": "比如说燕窝"
    },
    {
      "start": 417.84000000000003,
      "end": 418.92,
      "text": "海绳 血蛤"
    },
    {
      "start": 418.92,
      "end": 419.56,
      "text": "鱼翅"
    },
    {
      "start": 419.56,
      "end": 420.32,
      "text": "干鲍鱼"
    },
    {
      "start": 420.32,
      "end": 421.04,
      "text": "红菇"
    },
    {
      "start": 421.04,
      "end": 422.28000000000003,
      "text": "等等这种"
    },
    {
      "start": 422.28000000000003,
      "end": 424.24,
      "text": "贵重高端的食材"
    },
    {
      "start": 424.24,
      "end": 424.76,
      "text": "怎么办"
    }
  ]
}