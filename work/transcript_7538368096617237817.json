{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 1.8,
      "text": "公司的核算很混乱"
    },
    {
      "start": 1.8,
      "end": 3.3200000000000003,
      "text": "两套账还是两套系统"
    },
    {
      "start": 3.3200000000000003,
      "end": 5.12,
      "text": "就大大方方写着"
    },
    {
      "start": 5.12,
      "end": 6.4,
      "text": "谁负责内账"
    },
    {
      "start": 6.4,
      "end": 7.68,
      "text": "谁负责外账"
    },
    {
      "start": 7.68,
      "end": 8.96,
      "text": "那写在上哪"
    },
    {
      "start": 8.96,
      "end": 11.52,
      "text": "这玩意一查全都漏顶"
    },
    {
      "start": 11.52,
      "end": 13.040000000000001,
      "text": "方方刚来的第一周"
    },
    {
      "start": 13.040000000000001,
      "end": 15.36,
      "text": "前任这个财务负责人就被老板给开了"
    },
    {
      "start": 15.36,
      "end": 16.64,
      "text": "没有做任何交接"
    },
    {
      "start": 16.64,
      "end": 19.96,
      "text": "也没有人告诉方方这两个软件该怎么使用"
    },
    {
      "start": 19.96,
      "end": 21.240000000000002,
      "text": "为啥要有这两套账"
    },
    {
      "start": 21.240000000000002,
      "end": 22.0,
      "text": "都搞不清楚"
    },
    {
      "start": 22.0,
      "end": 23.56,
      "text": "他又找了经济的服务商"
    },
    {
      "start": 23.56,
      "end": 25.36,
      "text": "询问一共开发了多少个模块"
    },
    {
      "start": 25.36,
      "end": 27.52,
      "text": "然后每个模块开发的深度"
    },
    {
      "start": 27.52,
      "end": 28.92,
      "text": "大概到什么程度了"
    },
    {
      "start": 28.92,
      "end": 30.32,
      "text": "当时没管外账"
    },
    {
      "start": 30.32,
      "end": 31.48,
      "text": "为什么不管外账"
    },
    {
      "start": 31.48,
      "end": 31.8,
      "text": "来"
    },
    {
      "start": 31.8,
      "end": 33.28,
      "text": "这个其实是一个关键点"
    },
    {
      "start": 33.28,
      "end": 34.6,
      "text": "考验财务人员的智慧"
    },
    {
      "start": 34.6,
      "end": 35.64,
      "text": "每个行动的时候"
    },
    {
      "start": 35.64,
      "end": 37.96,
      "text": "你应该知道他为什么要那么选择"
    },
    {
      "start": 37.96,
      "end": 39.120000000000005,
      "text": "为什么忽略了外账"
    },
    {
      "start": 39.120000000000005,
      "end": 41.040000000000006,
      "text": "因为他认为规模不大"
    },
    {
      "start": 41.040000000000006,
      "end": 42.56,
      "text": "总体金额较小"
    },
    {
      "start": 42.56,
      "end": 44.52,
      "text": "对外的财务风险不高"
    },
    {
      "start": 44.52,
      "end": 46.08,
      "text": "所以先从书里内账开始"
    },
    {
      "start": 46.08,
      "end": 47.28,
      "text": "他先帮企业"
    },
    {
      "start": 47.28,
      "end": 48.36,
      "text": "书里义务流程"
    },
    {
      "start": 48.36,
      "end": 49.96,
      "text": "先书里的是销售流程"
    },
    {
      "start": 49.96,
      "end": 52.56,
      "text": "自己画了销售业务流程图"
    },
    {
      "start": 52.56,
      "end": 53.68000000000001,
      "text": "这个债务特训一个样"
    },
    {
      "start": 53.68000000000001,
      "end": 56.92,
      "text": "然后和销售老大销售人员助理克服辽"
    },
    {
      "start": 56.92,
      "end": 59.96,
      "text": "发现财务系统的陆入流程"
    },
    {
      "start": 59.96,
      "end": 61.72,
      "text": "和实际上销售人员"
    },
    {
      "start": 61.72,
      "end": 64.12,
      "text": "他的业务流程相差很远"
    },
    {
      "start": 64.12,
      "end": 65.6,
      "text": "所以一点一点的改"
    },
    {
      "start": 65.6,
      "end": 67.04,
      "text": "系统中的陆入流程"
    },
    {
      "start": 67.04,
      "end": 67.92,
      "text": "审核流程"
    },
    {
      "start": 67.92,
      "end": 68.72,
      "text": "批准流程"
    },
    {
      "start": 68.72,
      "end": 69.84,
      "text": "也就是单句流"
    },
    {
      "start": 69.84,
      "end": 72.48,
      "text": "要和业务流之间没有差异"
    },
    {
      "start": 72.48,
      "end": 74.6,
      "text": "这个会在我的内部控制"
    },
    {
      "start": 74.6,
      "end": 75.92,
      "text": "这门客里会给你讲"
    },
    {
      "start": 75.92,
      "end": 77.52000000000001,
      "text": "财务是靠单句"
    },
    {
      "start": 77.52000000000001,
      "end": 79.48,
      "text": "凭证来控制流程的"
    },
    {
      "start": 79.48,
      "end": 82.28,
      "text": "所以每一个流程的关键节点"
    },
    {
      "start": 82.28,
      "end": 83.24000000000001,
      "text": "是靠单句"
    },
    {
      "start": 83.24000000000001,
      "end": 86.36,
      "text": "陆入的单句和凭句来控制的"
    },
    {
      "start": 86.36,
      "end": 87.44,
      "text": "搭建ERP也好"
    },
    {
      "start": 87.44,
      "end": 88.4,
      "text": "搭建系统也好"
    },
    {
      "start": 88.4,
      "end": 90.56,
      "text": "一定是跟流程走的"
    },
    {
      "start": 90.56,
      "end": 92.08,
      "text": "然后在树里生产流程"
    },
    {
      "start": 92.08,
      "end": 94.24,
      "text": "与生产的基层人员"
    },
    {
      "start": 94.24,
      "end": 95.68,
      "text": "划生产流程图"
    },
    {
      "start": 95.68,
      "end": 98.24,
      "text": "仓库的收发存的流程"
    },
    {
      "start": 98.24,
      "end": 100.96,
      "text": "最终发现外账就是根据发票来做的"
    },
    {
      "start": 100.96,
      "end": 102.24,
      "text": "有发票就做外账"
    },
    {
      "start": 102.24,
      "end": 103.44,
      "text": "没发票的不入账"
    },
    {
      "start": 103.44,
      "end": 105.68,
      "text": "包括费用报销中没有发票的"
    },
    {
      "start": 105.68,
      "end": 106.96000000000001,
      "text": "也不入到外账"
    },
    {
      "start": 106.96000000000001,
      "end": 107.6,
      "text": "也是内账"
    },
    {
      "start": 107.6,
      "end": 108.0,
      "text": "怎么办"
    },
    {
      "start": 108.0,
      "end": 108.96000000000001,
      "text": "要你怎么处理"
    },
    {
      "start": 108.96000000000001,
      "end": 111.96000000000001,
      "text": "双方在2020年的汇算清缴的时候"
    },
    {
      "start": 111.96000000000001,
      "end": 113.12,
      "text": "统一了内外账"
    },
    {
      "start": 113.12,
      "end": 115.16,
      "text": "一次性補齐了所有的税金"
    },
    {
      "start": 115.16,
      "end": 117.16,
      "text": "从此没有内外账"
    },
    {
      "start": 117.16,
      "end": 118.08,
      "text": "会计和算"
    },
    {
      "start": 118.08,
      "end": 118.84,
      "text": "阳光化"
    },
    {
      "start": 118.84,
      "end": 119.36,
      "text": "合规"
    },
    {
      "start": 119.36,
      "end": 120.36,
      "text": "名正言顺"
    },
    {
      "start": 120.36,
      "end": 122.2,
      "text": "这样未来就可以名正言顺的"
    },
    {
      "start": 122.2,
      "end": 123.72,
      "text": "加大对单句的审核"
    },
    {
      "start": 123.72,
      "end": 125.6,
      "text": "要求数据的准确性了"
    },
    {
      "start": 125.6,
      "end": 126.75999999999999,
      "text": "我这里来问一下"
    },
    {
      "start": 126.75999999999999,
      "end": 127.36,
      "text": "请问"
    },
    {
      "start": 127.36,
      "end": 129.12,
      "text": "他们公司原来的两桃账"
    },
    {
      "start": 129.12,
      "end": 130.96,
      "text": "是怎么搭建出来的"
    },
    {
      "start": 130.96,
      "end": 131.68,
      "text": "我们先说"
    },
    {
      "start": 131.68,
      "end": 132.56,
      "text": "我不否认"
    },
    {
      "start": 132.56,
      "end": 135.4,
      "text": "有一部分是老板要求搭建出来的"
    },
    {
      "start": 135.4,
      "end": 136.92,
      "text": "但有没有一部分"
    },
    {
      "start": 136.92,
      "end": 138.68,
      "text": "其实并不是老板的要求"
    },
    {
      "start": 138.68,
      "end": 140.24,
      "text": "而是一部分会计人员"
    },
    {
      "start": 140.24,
      "end": 141.72,
      "text": "给出来的专业建议"
    },
    {
      "start": 141.72,
      "end": 143.51999999999998,
      "text": "恰恰是财务人员"
    },
    {
      "start": 143.52,
      "end": 145.16,
      "text": "给财务人员挖了坑"
    },
    {
      "start": 145.16,
      "end": 146.72,
      "text": "你看在这个案例里面"
    },
    {
      "start": 146.72,
      "end": 149.16,
      "text": "这个老板并没有拒绝他"
    },
    {
      "start": 149.16,
      "end": 150.20000000000002,
      "text": "两桃账合一"
    },
    {
      "start": 150.20000000000002,
      "end": 152.0,
      "text": "也就是在老板那没有问题"
    },
    {
      "start": 152.0,
      "end": 153.8,
      "text": "其实有一些会计人员"
    },
    {
      "start": 153.8,
      "end": 155.32000000000002,
      "text": "他的专业水平不够"
    },
    {
      "start": 155.32000000000002,
      "end": 157.0,
      "text": "他认为能给公司贡献的"
    },
    {
      "start": 157.0,
      "end": 158.68,
      "text": "就是两桃账和三桃账"
    },
    {
      "start": 158.68,
      "end": 159.8,
      "text": "他除了做两桃账"
    },
    {
      "start": 159.8,
      "end": 161.64000000000001,
      "text": "三桃账以外没有别的技能了"
    },
    {
      "start": 161.64000000000001,
      "end": 164.08,
      "text": "但是其实这样会害死很多企业"
    },
    {
      "start": 164.08,
      "end": 167.20000000000002,
      "text": "最主要是害死后面接手的财务人员"
    },
    {
      "start": 167.20000000000002,
      "end": 168.76000000000002,
      "text": "他倒是一拍屁股早了"
    },
    {
      "start": 168.76000000000002,
      "end": 170.76000000000002,
      "text": "你接手的最惨"
    },
    {
      "start": 170.76000000000002,
      "end": 171.08,
      "text": "好"
    },
    {
      "start": 171.08,
      "end": 173.28,
      "text": "再说成本和算的梳理"
    },
    {
      "start": 173.28,
      "end": 175.12,
      "text": "按理说微星棒的成本和算"
    },
    {
      "start": 175.12,
      "end": 177.52,
      "text": "应该是按照什么来进行分担的"
    },
    {
      "start": 177.52,
      "end": 178.88,
      "text": "原材料肯定是Bomb"
    },
    {
      "start": 178.88,
      "end": 181.68,
      "text": "那么制造费用应该是按供需供食"
    },
    {
      "start": 181.68,
      "end": 183.96,
      "text": "但是当时他们生产部门说"
    },
    {
      "start": 183.96,
      "end": 186.76,
      "text": "他们生产的产品都是小批量多品种"
    },
    {
      "start": 186.76,
      "end": 187.64,
      "text": "品类特别多"
    },
    {
      "start": 187.64,
      "end": 189.52,
      "text": "包括你比如说像电商这边"
    },
    {
      "start": 189.52,
      "end": 192.4,
      "text": "还有那种生产一个到两个的定制产品"
    },
    {
      "start": 192.4,
      "end": 193.92000000000002,
      "text": "就不到供食的记录"
    },
    {
      "start": 193.92000000000002,
      "end": 195.88,
      "text": "如果你要再记录供食的话"
    },
    {
      "start": 195.88,
      "end": 197.2,
      "text": "要花费很多人力"
    },
    {
      "start": 197.2,
      "end": 198.76,
      "text": "生产部就认为这没必要"
    },
    {
      "start": 198.76,
      "end": 200.32,
      "text": "产品供食都是忽略甜的"
    },
    {
      "start": 200.32,
      "end": 202.68,
      "text": "供食汇总出来是一万个小时"
    },
    {
      "start": 202.72,
      "end": 205.16,
      "text": "结果在统计一下打卡烤芹"
    },
    {
      "start": 205.16,
      "end": 206.92000000000002,
      "text": "烤芹只有8000个小时"
    },
    {
      "start": 206.92000000000002,
      "end": 208.32,
      "text": "这种奇怪的现象"
    },
    {
      "start": 208.32,
      "end": 209.92000000000002,
      "text": "但实际情况是"
    },
    {
      "start": 209.92000000000002,
      "end": 212.76000000000002,
      "text": "生产部只有20个到30个人员"
    },
    {
      "start": 212.76000000000002,
      "end": 216.12,
      "text": "确实让它单独统一供食有点问题"
    },
    {
      "start": 216.12,
      "end": 217.12,
      "text": "它忙不过来"
    },
    {
      "start": 217.12,
      "end": 218.56,
      "text": "而且生产部很强势"
    },
    {
      "start": 218.56,
      "end": 220.48000000000002,
      "text": "老板也不在意成本和算"
    },
    {
      "start": 220.48000000000002,
      "end": 221.08,
      "text": "怎么办"
    },
    {
      "start": 221.08,
      "end": 221.88,
      "text": "杨妮怎么办"
    },
    {
      "start": 221.88,
      "end": 223.88,
      "text": "这就看财务部的灵活性了"
    },
    {
      "start": 223.88,
      "end": 225.08,
      "text": "你要不要直接就干"
    },
    {
      "start": 225.08,
      "end": 226.52,
      "text": "必须要他们出工时"
    },
    {
      "start": 226.52,
      "end": 228.08,
      "text": "或者财务部下现场"
    },
    {
      "start": 228.08,
      "end": 229.60000000000002,
      "text": "如果财务部没有时间"
    },
    {
      "start": 229.60000000000002,
      "end": 230.96,
      "text": "也没有那么多人下现场"
    },
    {
      "start": 230.96,
      "end": 231.36,
      "text": "怎么办"
    },
    {
      "start": 231.4,
      "end": 234.12,
      "text": "这个时候方方他们并没有很较劲"
    },
    {
      "start": 234.12,
      "end": 235.48000000000002,
      "text": "这只聪明了一点"
    },
    {
      "start": 235.48000000000002,
      "end": 237.20000000000002,
      "text": "财务部们关注到"
    },
    {
      "start": 237.20000000000002,
      "end": 239.72000000000003,
      "text": "公司整体人工成本和制造费用"
    },
    {
      "start": 239.72000000000003,
      "end": 242.68,
      "text": "仅仅占总成本的18%左右"
    },
    {
      "start": 242.68,
      "end": 243.64000000000001,
      "text": "占比并不高"
    },
    {
      "start": 243.64000000000001,
      "end": 245.12,
      "text": "就算分配不合理"
    },
    {
      "start": 245.12,
      "end": 246.08,
      "text": "分摊不合理"
    },
    {
      "start": 246.08,
      "end": 249.16000000000003,
      "text": "也不会对产品成本造成本质性的误导"
    },
    {
      "start": 249.16000000000003,
      "end": 251.12,
      "text": "本着重要性原则财务部决定"
    },
    {
      "start": 251.12,
      "end": 252.60000000000002,
      "text": "根据生产领料单"
    },
    {
      "start": 252.60000000000002,
      "end": 255.08,
      "text": "对应的生产订单中的成本对象"
    },
    {
      "start": 255.08,
      "end": 257.24,
      "text": "也就是这个产品的名称和批次"
    },
    {
      "start": 257.24,
      "end": 258.84000000000003,
      "text": "计算每张订单中"
    },
    {
      "start": 258.84000000000003,
      "end": 260.68,
      "text": "每款产品所使用的材料"
    },
    {
      "start": 260.68,
      "end": 262.88,
      "text": "也就是说根据材料占比"
    },
    {
      "start": 262.88,
      "end": 265.12,
      "text": "分摊人工成本和制造费用"
    },
    {
      "start": 265.12,
      "end": 266.52,
      "text": "材料成本越高"
    },
    {
      "start": 266.52,
      "end": 268.6,
      "text": "分摊的人工和制造费用就会越高"
    },
    {
      "start": 268.6,
      "end": 269.56,
      "text": "虽然不准确"
    },
    {
      "start": 269.56,
      "end": 270.48,
      "text": "但基本合理"
    },
    {
      "start": 270.48,
      "end": 272.44,
      "text": "我说了开局不一定是完美的"
    },
    {
      "start": 272.44,
      "end": 273.8,
      "text": "你可以使个垃圾开局"
    },
    {
      "start": 273.8,
      "end": 276.68,
      "text": "目前企业将近2个亿的销售规模"
    },
    {
      "start": 276.68,
      "end": 277.28000000000003,
      "text": "要不要改"
    },
    {
      "start": 277.28000000000003,
      "end": 277.88,
      "text": "肯定要改"
    },
    {
      "start": 277.88,
      "end": 279.08,
      "text": "2025年的5月份"
    },
    {
      "start": 279.08,
      "end": 280.52,
      "text": "上线了MES系统"
    },
    {
      "start": 280.52,
      "end": 281.64,
      "text": "就是MES系统"
    },
    {
      "start": 281.64,
      "end": 284.16,
      "text": "生产线上小组长要通过系统"
    },
    {
      "start": 284.16,
